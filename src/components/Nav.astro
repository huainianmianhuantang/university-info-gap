---
import { SITE } from '../config';

const links = [
  { href: '/', label: '首页' },
  { href: '/universities/', label: '大学库' },
  { href: '/985-map/', label: '985地图' },
  { href: '/resources/', label: '资料库' },
  { href: '/quiz/', label: '选校测评' },
  { href: '/favorites/', label: '我的收藏', badge: true },
  { href: '/articles/', label: '专题文章' },
  { href: '/submit/', label: '我要投稿' },
  { href: '/about/', label: '关于本站' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" transition:name="site-header">
  <div class="container">
    <a class="logo" href="/">
      <span class="logo-mark">镜</span>
      <span>{SITE.title}</span>
    </a>
    <div class="acct-wrap" id="acctWrap"></div>
    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="打开菜单">
      ☰
    </button>
    <button class="theme-toggle" id="themeToggle" aria-label="切换深浅色模式" aria-pressed="false" title="切换深色 / 浅色模式">🌙</button>
    <nav class="nav" id="siteNav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          data-astro-prefetch
          aria-current={
            link.href === '/'
              ? currentPath === '/'
                ? 'page'
                : undefined
              : currentPath.startsWith(link.href)
                ? 'page'
                : undefined
          }
        >
          {link.label}
          {link.badge && <span class="nav-badge" id="favNavBadge" hidden></span>}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { getProfile, logout } from '../lib/account';

  type AppWindow = Window & {
    __appReady?: (fn: () => void) => void;
    __appBind?: (el: Element | null, key: string, type: string, fn: EventListener) => void;
  };
  const appWin = window as AppWindow;
  const bind = (el: Element | null, key: string, type: string, fn: EventListener) =>
    appWin.__appBind?.(el, key, type, fn);

  function renderAcct() {
    const acctWrap = document.getElementById('acctWrap');
    if (!acctWrap) return;
    const profile = getProfile();
    const logged = Boolean(profile);
    acctWrap.innerHTML = '';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'acct-chip';
    btn.textContent = logged ? `👤 ${profile?.nickname ?? ''} ▾` : '登录 / 注册';
    acctWrap.appendChild(btn);
    if (logged) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = document.createElement('div');
        menu.className = 'acct-menu';
        const me = document.createElement('a');
        me.href = '/account/';
        me.textContent = '👤 个人中心';
        const out = document.createElement('button');
        out.type = 'button';
        out.textContent = '🚪 退出登录';
        out.addEventListener('click', () => {
          logout();
          menu.remove();
        });
        menu.append(me, out);
        acctWrap.appendChild(menu);
        const closeMenu = (ev: Event) => {
          if (!menu.contains(ev.target as Node)) menu.remove();
          document.removeEventListener('click', closeMenu);
        };
        document.addEventListener('click', closeMenu);
      });
    } else {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('account:open'));
      });
    }
  }

  const setTheme = (t) => {
    const root = document.documentElement;
    // 切换时暂时禁用过渡：整页元素同时变色容易卡顿，改为瞬时切换
    root.classList.add('theme-switching');
    root.setAttribute('data-theme', t);
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
    const btn = document.getElementById('themeToggle');
    if (btn) {
      btn.textContent = t === 'dark' ? '☀️' : '🌙';
      btn.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
    }
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', t === 'dark' ? '#0d1526' : '#1f5eff');
    try {
      localStorage.setItem('theme', t);
    } catch {
      /* ignore */
    }
  };

  const toggleTheme = () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    if (document.startViewTransition && !reduced) {
      root.classList.add('theme-vt');
      try {
        const vt = document.startViewTransition(() => setTheme(next));
        vt.finished
          .then(() => root.classList.remove('theme-vt'))
          .catch(() => root.classList.remove('theme-vt'));
        return;
      } catch {
        root.classList.remove('theme-vt');
      }
    }
    setTheme(next);
  };

  const savedTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  function updateFavBadge() {
    const favBadge = document.getElementById('favNavBadge');
    if (!favBadge) return;
    try {
      const n = JSON.parse(localStorage.getItem('fav-universities') || '[]').length;
      favBadge.textContent = n > 0 ? n : '';
      favBadge.hidden = n === 0;
    } catch {
      favBadge.hidden = true;
    }
  }

  function initNav() {
    const header = document.querySelector('.site-header');
    const toggle = document.getElementById('navToggle');
    bind(toggle, 'appNavToggle', 'click', () => {
      const open = header?.classList.toggle('nav-open') ?? false;
      toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (toggle) toggle.textContent = open ? '✕' : '☰';
    });

    header?.querySelectorAll('.nav a').forEach((a) =>
      bind(a, 'appNavLink', 'click', () => {
        header.classList.remove('nav-open');
        const t = document.getElementById('navToggle');
        t?.setAttribute('aria-expanded', 'false');
        if (t) t.textContent = '☰';
      }),
    );

    bind(document.getElementById('themeToggle'), 'appThemeToggle', 'click', toggleTheme);

    setTheme(
      savedTheme() ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'),
    );
    renderAcct();
    updateFavBadge();
  }

  // 窗口级监听只注册一次，处理函数每次按当前 DOM 查询
  window.addEventListener('account:change', renderAcct);
  window.addEventListener('storage', updateFavBadge);
  window.addEventListener('focus', updateFavBadge);

  appWin.__appReady?.(initNav);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>
