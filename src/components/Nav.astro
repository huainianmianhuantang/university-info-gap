---
import { SITE } from '../config';

const links = [
  { href: '/', label: '首页' },
  { href: '/universities/', label: '大学库' },
  { href: '/resources/', label: '资料库' },
  { href: '/quiz/', label: '选校测评' },
  { href: '/favorites/', label: '我的收藏', badge: true },
  { href: '/articles/', label: '专题文章' },
  { href: '/submit/', label: '我要投稿' },
  { href: '/about/', label: '关于本站' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a class="logo" href="/">
      <span class="logo-mark">镜</span>
      <span>{SITE.title}</span>
    </a>
    <div class="acct-wrap" id="acctWrap"></div>
    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="打开菜单">
      ☰
    </button>
    <button class="theme-toggle" id="themeToggle" aria-label="切换深浅色模式">🌙</button>
    <nav class="nav" id="siteNav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={
            link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href)
              ? 'page'
              : undefined
          }
        >
          {link.label}
          {link.badge && <span class="nav-badge" id="favNavBadge" hidden></span>}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { getProfile, logout } from '../lib/account';

  const toggle = document.getElementById('navToggle');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('nav-open') ?? false;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.textContent = open ? '✕' : '☰';
  });

  header?.querySelectorAll('.nav a').forEach((a) =>
    a.addEventListener('click', () => {
      header.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = '☰';
    }),
  );

  const themeBtn = document.getElementById('themeToggle');
  const acctWrap = document.getElementById('acctWrap');

  function renderAcct() {
    if (!acctWrap) return;
    const profile = getProfile();
    const logged = Boolean(profile);
    acctWrap.innerHTML = '';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'acct-chip';
    btn.textContent = logged ? `👤 ${profile?.nickname ?? ''} ▾` : '登录 / 注册';
    acctWrap.appendChild(btn);
    if (logged) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = document.createElement('div');
        menu.className = 'acct-menu';
        const me = document.createElement('a');
        me.href = '/account/';
        me.textContent = '👤 个人中心';
        const out = document.createElement('button');
        out.type = 'button';
        out.textContent = '🚪 退出登录';
        out.addEventListener('click', () => {
          logout();
          menu.remove();
        });
        menu.append(me, out);
        acctWrap.appendChild(menu);
        const closeMenu = (ev: Event) => {
          if (!menu.contains(ev.target as Node)) menu.remove();
          document.removeEventListener('click', closeMenu);
        };
        document.addEventListener('click', closeMenu);
      });
    } else {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('account:open'));
      });
    }
  }

  window.addEventListener('account:change', renderAcct);
  renderAcct();

  const applyTheme = (t) => {
    const root = document.documentElement;
    // 切换时暂时禁用过渡：整页元素同时变色容易卡顿，改为瞬时切换
    root.classList.add('theme-switching');
    root.setAttribute('data-theme', t);
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
    if (themeBtn) themeBtn.textContent = t === 'dark' ? '☀️' : '🌙';
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', t === 'dark' ? '#0d1526' : '#1f5eff');
    try {
      localStorage.setItem('theme', t);
    } catch {
      /* ignore */
    }
  };
  const savedTheme = (() => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  })();
  applyTheme(
    savedTheme ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'),
  );
  themeBtn?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });

  const favBadge = document.getElementById('favNavBadge');
  if (favBadge) {
    const updateBadge = () => {
      try {
        const n = JSON.parse(localStorage.getItem('fav-universities') || '[]').length;
        favBadge.textContent = n > 0 ? n : '';
        favBadge.hidden = n === 0;
      } catch {
        favBadge.hidden = true;
      }
    };
    updateBadge();
    window.addEventListener('storage', updateBadge);
    window.addEventListener('focus', updateBadge);
  }
</script>
