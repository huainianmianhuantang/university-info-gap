<button class="help-fab" id="helpFab" type="button" aria-label="帮助与新手引导">❓</button>
<div class="help-pop" id="helpPop" hidden role="dialog" aria-label="帮助菜单">
  <button class="help-close" id="helpClose" type="button" aria-label="关闭">×</button>
  <b class="help-title">需要帮忙？</b>
  <a href="#" id="helpOpenAi">🤖 问问 AI 小助手</a>
  <a href="/#guide">🎓 新手引导（重看）</a>
  <a href="/articles/">📚 图文教程</a>
  <a href="/search/">🔍 站内搜索</a>
  <a href="/submit/">💬 反馈建议</a>
  <a href="#" data-onboard-redo>🔄 重新做测评</a>
</div>

<script>
  const fab = document.getElementById('helpFab') as HTMLButtonElement;
  const pop = document.getElementById('helpPop') as HTMLElement;
  const close = document.getElementById('helpClose') as HTMLButtonElement;
  const openAi = document.getElementById('helpOpenAi') as HTMLAnchorElement;

  function toggle(open?: boolean) {
    const next = open ?? pop.hidden;
    pop.hidden = !next;
    fab.setAttribute('aria-expanded', next ? 'true' : 'false');
  }

  fab.addEventListener('click', () => toggle());
  close.addEventListener('click', () => toggle(false));
  openAi.addEventListener('click', (e) => {
    e.preventDefault();
    toggle(false);
    window.dispatchEvent(new CustomEvent('ai:open'));
  });
  document.addEventListener('click', (e) => {
    if (!pop.hidden && !pop.contains(e.target as Node) && !fab.contains(e.target as Node)) {
      toggle(false);
    }
  });

</script>

<style>
  .help-fab {
    position: fixed;
    right: 22px;
    bottom: calc(82px + env(safe-area-inset-bottom, 0px));
    z-index: 56;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(31, 94, 255, 0.35);
    transition: transform 0.15s ease;
  }
  .help-fab:hover {
    transform: translateY(-3px) rotate(-8deg);
  }
  .help-pop {
    position: fixed;
    right: 18px;
    bottom: calc(140px + env(safe-area-inset-bottom, 0px));
    z-index: 57;
    width: 230px;
    background: var(--surface);
    color: var(--text);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    padding: 16px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    animation: help-pop 0.2s ease;
  }
  @keyframes help-pop {
    from {
      transform: translateY(8px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .help-pop {
      animation: none;
    }
  }
  .help-close {
    position: absolute;
    top: 10px;
    right: 12px;
    border: 0;
    background: transparent;
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
  }
  .help-title {
    margin-bottom: 8px;
    font-size: 15px;
  }
  .help-pop a {
    display: block;
    padding: 9px 10px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
  }
  .help-pop a:hover {
    background: var(--primary-soft);
    color: var(--primary);
    text-decoration: none;
  }
</style>
