---
interface Video {
  title: string;
  platform: 'bilibili' | 'youku' | 'tencent' | '其他';
  id: string;
  url?: string;
  source: string;
  description: string;
  tags?: string[];
}

const { video, className = '' } = Astro.props as {
  video: Video;
  className?: string;
};

const embedUrl = video.platform === 'bilibili' && video.id
  ? `https://player.bilibili.com/player.html?bvid=${video.id}&page=1&high_quality=1&danmaku=0`
  : null;

const fallbackUrl =
  video.url && /^https?:\/\//.test(video.url)
    ? video.url
    : video.id
      ? `https://www.bilibili.com/video/${video.id}`
      : null;
---

<div class:list={['card', 'video-card', className]} data-tags={(video.tags ?? []).join(' ')}>
  <div class="video-frame-wrap">
    {embedUrl ? (
      <div
        class="video-lazy"
        role="button"
        tabindex="0"
        data-src={embedUrl}
        data-title={video.title}
        aria-label={`播放视频：${video.title}`}
      >
        <span class="video-lazy-play">▶</span>
        <span class="video-lazy-hint">点击播放 · 更省流量</span>
      </div>
    ) : (
      <div class="video-placeholder">
        <div>
          <p>示例视频（待替换）</p>
          {fallbackUrl && <a href={fallbackUrl} target="_blank" rel="noopener">前往原平台观看 →</a>}
        </div>
      </div>
    )}
  </div>
  <div class="video-body">
    <h3>{video.title}</h3>
    {video.tags && video.tags.length > 0 && (
      <div class="video-tags">
        {video.tags.map((tag) => <span class="video-tag">{tag}</span>)}
      </div>
    )}
    {video.source && <p>来源：{video.source}</p>}
    {video.description && <p>{video.description}</p>}
    {fallbackUrl && (
      <p class="small video-fallback">
        <a href={fallbackUrl} target="_blank" rel="noopener">打不开？去 B 站观看 →</a>
      </p>
    )}
  </div>
</div>

<script>
  // 视频点击才加载：避免页面同时拉取多个 B 站播放器导致卡顿
  if (!window.__videoLazyBound) {
    window.__videoLazyBound = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const wrap = target.closest('.video-lazy') as HTMLElement | null;
      if (!wrap || wrap.dataset.loaded) return;
      const src = wrap.dataset.src;
      if (!src) return;
      wrap.dataset.loaded = '1';
      const title = wrap.dataset.title || '视频';
      wrap.innerHTML =
        `<iframe src="${src}" title="${title}" allowfullscreen referrerpolicy="no-referrer" allow="autoplay; fullscreen"></iframe>`;
    });
  }
</script>
