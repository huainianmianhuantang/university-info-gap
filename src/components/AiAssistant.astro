<button class="ai-fab" id="aiFab" type="button" aria-label="打开小助手" aria-expanded="false">💬</button>
<button class="ai-dock" id="aiDock" hidden type="button" aria-label="展开小助手">💬<span>小助手</span></button>

<div class="ai-panel" id="aiPanel" hidden role="dialog" aria-modal="false" aria-label="小助手">
  <div class="ai-head">
    <span class="ai-avatar">💬</span>
    <div class="ai-head-text">
      <b>选校小助手</b>
      <span class="ai-status">随时帮你快速了解网站和大学</span>
    </div>
    <button class="ai-close" id="aiClose" type="button" aria-label="关闭">×</button>
  </div>
  <div class="ai-chips" id="aiChips">
    <button type="button">这个网站怎么用？</button>
    <button type="button">怎么选专业方向？</button>
    <button type="button">转专业要注意什么？</button>
    <button type="button">帮我推荐几所 985</button>
  </div>
  <div class="ai-msgs" id="aiMsgs" aria-live="polite"></div>
  <div class="ai-input-row">
    <textarea id="aiInput" rows="1" placeholder="想问点什么…（Enter 发送）"></textarea>
    <button class="ai-send" id="aiSend" type="button">发送</button>
  </div>
  <div class="ai-foot">
    <span>内容仅供参考，请以学校官方发布为准</span>
    <button id="aiClear" type="button">清空对话</button>
  </div>
</div>

<script>
  import { getProfile } from '../lib/account';

  function chatKey() {
    const p = getProfile();
    return p ? `ai-chat-${p.uid}` : 'ai-chat';
  }
  const fab = document.getElementById('aiFab') as HTMLButtonElement;
  const dock = document.getElementById('aiDock') as HTMLButtonElement;
  const panel = document.getElementById('aiPanel') as HTMLElement;
  const close = document.getElementById('aiClose') as HTMLButtonElement;
  const chips = document.getElementById('aiChips') as HTMLElement;
  const msgs = document.getElementById('aiMsgs') as HTMLElement;
  const input = document.getElementById('aiInput') as HTMLTextAreaElement;
  const send = document.getElementById('aiSend') as HTMLButtonElement;
  const clear = document.getElementById('aiClear') as HTMLButtonElement;

  let history: { role: 'user' | 'assistant'; content: string }[] = [];
  try {
    const saved = JSON.parse(localStorage.getItem(chatKey()) || '[]');
    if (Array.isArray(saved)) history = saved.slice(-20);
  } catch {
    history = [];
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
    );
  }

  function renderMarkdown(text: string) {
    let t = escapeHtml(text);
    t = t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    t = t.replace(
      /\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g,
      '<a href="$2" rel="noopener" target="_blank">$1</a>',
    );
    t = t.replace(/\n/g, '<br>');
    return t;
  }

  function addMsg(role: 'user' | 'assistant', content: string) {
    const wrap = document.createElement('div');
    wrap.className = `ai-msg ${role}`;
    wrap.innerHTML = role === 'user' ? escapeHtml(content) : renderMarkdown(content);
    msgs.appendChild(wrap);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function renderHistory() {
    msgs.innerHTML = '';
    if (history.length === 0) {
      const hi = document.createElement('div');
      hi.className = 'ai-msg assistant ai-hello';
      const profile = getProfile();
      hi.innerHTML =
        (profile
          ? `你好呀 ${escapeHtml(profile.nickname)}，我是小助手 💬 `
          : '你好呀，我是小助手 💬 ') +
        '可以问我：这个网站怎么用、怎么选专业方向、<strong>转专业</strong>要注意什么……' +
        (profile ? '' : '（登录后对话会按账号保存）');
      msgs.appendChild(hi);
    } else {
      history.forEach((m) => addMsg(m.role, m.content));
    }
  }

  function save() {
    try {
      localStorage.setItem(chatKey(), JSON.stringify(history.slice(-20)));
    } catch {
      /* ignore */
    }
  }

  function showTyping() {
    const t = document.createElement('div');
    t.className = 'ai-msg assistant ai-typing';
    t.innerHTML = '<i></i><i></i><i></i>';
    msgs.appendChild(t);
    msgs.scrollTop = msgs.scrollHeight;
    return t;
  }

  async function ask(text: string) {
    const content = text.trim();
    if (!content || send.disabled) return;
    history.push({ role: 'user', content });
    addMsg('user', content);
    input.value = '';
    autoGrow();
    save();

    const typing = showTyping();
    send.disabled = true;
    input.disabled = true;
    try {
      const res = await fetch('/api/assistant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history, userName: getProfile()?.nickname }),
      });
      const data = await res.json();
      typing.remove();
      if (!res.ok || !data.reply) {
        const err = document.createElement('div');
        err.className = 'ai-msg assistant ai-err';
        err.innerHTML = `😵 ${escapeHtml(data?.error || '出错了，请稍后再试')} <button type="button" class="ai-retry">重试</button>`;
        msgs.appendChild(err);
        const retry = err.querySelector('.ai-retry') as HTMLButtonElement;
        retry.addEventListener('click', () => {
          history.pop();
          msgs.removeChild(err);
          ask(content);
        });
        msgs.scrollTop = msgs.scrollHeight;
        return;
      }
      history.push({ role: 'assistant', content: data.reply });
      addMsg('assistant', data.reply);
      save();
    } catch {
      typing.remove();
      const err = document.createElement('div');
      err.className = 'ai-msg assistant ai-err';
      err.textContent = '😵 网络开小差了，请稍后再试。';
      msgs.appendChild(err);
      msgs.scrollTop = msgs.scrollHeight;
    } finally {
      send.disabled = false;
      input.disabled = false;
      input.focus();
    }
  }

  function autoGrow() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
  }

  function open() {
    panel.hidden = false;
    dock.hidden = true;
    fab.hidden = false;
    fab.setAttribute('aria-expanded', 'true');
    renderHistory();
    requestAnimationFrame(() => input.focus());
  }

  function closePanel() {
    panel.hidden = true;
    dock.hidden = true;
    fab.hidden = false;
    fab.setAttribute('aria-expanded', 'false');
  }

  function minimize() {
    panel.hidden = true;
    dock.hidden = false;
    fab.hidden = true;
    fab.setAttribute('aria-expanded', 'false');
  }

  fab.addEventListener('click', () => (panel.hidden ? open() : closePanel()));
  dock.addEventListener('click', () => open());
  window.addEventListener('ai:open', () => open());
  close.addEventListener('click', minimize);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closePanel();
  });

  send.addEventListener('click', () => ask(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      ask(input.value);
    }
  });
  input.addEventListener('input', autoGrow);

  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (b) ask(b.textContent || '');
  });

  clear.addEventListener('click', () => {
    history = [];
    try {
      localStorage.removeItem(chatKey());
    } catch {
      /* ignore */
    }
    renderHistory();
  });

  window.addEventListener('account:change', () => {
    history = [];
    try {
      const saved = JSON.parse(localStorage.getItem(chatKey()) || '[]');
      if (Array.isArray(saved)) history = saved.slice(-20);
    } catch {
      history = [];
    }
    if (!panel.hidden) renderHistory();
  });
</script>

