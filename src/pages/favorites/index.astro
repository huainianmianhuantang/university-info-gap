---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const schools = (await getCollection('universities')).map((u) => ({
  id: u.id,
  name: u.data.name,
  cover: u.data.cover,
  type: u.data.type,
  province: u.data.province,
  city: u.data.city,
  videos: u.data.videos.length,
  materials: u.data.materials.length,
}));
---

<BaseLayout
  title="我的收藏"
  description="你收藏的大学列表，支持一键导出，方便和家人一起商量。"
>
  <div class="container page">
    <div class="page-hero">
      <h1>我的收藏</h1>
      <p>
        在大学库卡片左上角点 ★ 即可收藏。收藏只保存在你的浏览器本地，可一键导出文本与家人分享。
      </p>
      <button class="btn btn-ghost" id="exportFavs" type="button">导出收藏</button>
      <button class="btn btn-ghost" id="exportJson" type="button">导出 JSON</button>
    </div>

    <div id="favApp">
      <p class="muted" id="favEmpty" hidden>
        还没有收藏任何学校。去<a href="/universities/">大学库</a>逛逛，点卡片左上角 ★ 收藏；
        或者先做一次<a href="/quiz/">选校测评</a>，把推荐学校一键收藏。
      </p>
      <div class="card filters" id="favFilters" hidden>
        <div class="filter-group">
          <label>
            省份
            <select id="favProvince"><option value="">全部省份</option></select>
          </label>
        </div>
        <div class="filter-group">
          <label>
            类型
            <select id="favType"><option value="">全部类型</option></select>
          </label>
        </div>
      </div>
      <div class="grid grid-universities" id="favGrid"></div>
    </div>

    <div class="compare-bar" id="cmpBar" hidden>
      <span id="cmpCount">已选 0 所</span>
      <a class="btn btn-primary" id="cmpBtn" href="/compare/?u=">开始对比</a>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ schools }}>
  const grid = document.getElementById('favGrid');
  const empty = document.getElementById('favEmpty');
  const exportBtn = document.getElementById('exportFavs');
  const favFilters = document.getElementById('favFilters');
  const favProvince = document.getElementById('favProvince');
  const favType = document.getElementById('favType');

  let favs = [];
  try {
    favs = JSON.parse(localStorage.getItem('fav-universities') || '[]');
  } catch {
    favs = [];
  }

  const picked = favs.map((id) => schools.find((s) => s.id === id)).filter(Boolean);

  if (picked.length === 0) {
    empty.hidden = false;
    if (exportBtn) exportBtn.hidden = true;
  } else {
    picked.forEach((s) => {
      const wrap = document.createElement('div');
      wrap.className = 'u-item';
      wrap.dataset.province = s.province;
      wrap.dataset.type = s.type;
      const label = document.createElement('label');
      label.className = 'compare-check';
      label.title = '加入对比';
      label.innerHTML = `<input type="checkbox" class="fav-compare" value="${s.id}" aria-label="对比${s.name}"><span>对比</span>`;
      wrap.appendChild(label);
      const a = document.createElement('a');
      a.className = 'card university-card';
      a.href = `/universities/${s.id}/`;
      const img = document.createElement('img');
      img.className = 'university-cover';
      img.src = s.cover;
      img.alt = `${s.name} 校徽`;
      img.loading = 'lazy';
      a.appendChild(img);
      const body = document.createElement('div');
      body.className = 'university-body';
      body.innerHTML = `
        <h3>${s.name}</h3>
        <p class="small muted">${s.type} · ${s.province} ${s.city}</p>
        <div class="university-stats">
          <span class="stat-chip">🎬 ${s.videos} 视频</span>
          <span class="stat-chip">📄 ${s.materials} 资料</span>
        </div>
      `;
      a.appendChild(body);
      wrap.appendChild(a);
      grid.appendChild(wrap);
    });

    const provinces = [...new Set(picked.map((s) => s.province))].sort((a, b) =>
      a.localeCompare(b, 'zh'),
    );
    const types = [...new Set(picked.map((s) => s.type))].sort((a, b) =>
      a.localeCompare(b, 'zh'),
    );
    provinces.forEach((p) => {
      const opt = document.createElement('option');
      opt.value = p;
      opt.textContent = p;
      favProvince?.appendChild(opt);
    });
    types.forEach((t) => {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = `${t}类`;
      favType?.appendChild(opt);
    });
    if (favFilters) favFilters.hidden = false;
  }

  function applyFavFilter() {
    const pv = favProvince?.value ?? '';
    const tp = favType?.value ?? '';
    document.querySelectorAll('#favGrid .u-item').forEach((el) => {
      const okP = !pv || el.dataset.province === pv;
      const okT = !tp || el.dataset.type === tp;
      el.style.display = okP && okT ? '' : 'none';
    });
  }
  favProvince?.addEventListener('change', applyFavFilter);
  favType?.addEventListener('change', applyFavFilter);

  const exportJsonBtn = document.getElementById('exportJson');
  exportJsonBtn?.addEventListener('click', () => {
    if (picked.length === 0) return;
    const json = JSON.stringify(picked, null, 2);
    navigator.clipboard
      ?.writeText(json)
      .then(() => {
        exportJsonBtn.textContent = '已复制 ✓';
        setTimeout(() => (exportJsonBtn.textContent = '导出 JSON'), 1600);
      })
      .catch(() => {});
  });

  const COMPARE_KEY = 'compare-list';
  let cmp = [];
  try {
    cmp = JSON.parse(localStorage.getItem(COMPARE_KEY) || '[]');
  } catch {
    cmp = [];
  }
  const cmpBoxes = Array.from(document.querySelectorAll('.fav-compare'));
  cmpBoxes.forEach((c) => {
    c.checked = cmp.includes(c.value);
  });
  const cmpBar = document.getElementById('cmpBar');
  const cmpCount = document.getElementById('cmpCount');
  const cmpBtn = document.getElementById('cmpBtn');
  function updateCmp() {
    const sel = cmpBoxes.filter((c) => c.checked).map((c) => c.value);
    if (sel.length > 3) {
      const last = sel[sel.length - 1];
      const box = cmpBoxes.find((c) => c.value === last);
      if (box) box.checked = false;
      return updateCmp();
    }
    if (cmpBar) cmpBar.hidden = sel.length < 2;
    if (cmpCount) cmpCount.textContent = `已选 ${sel.length} 所`;
    if (cmpBtn) cmpBtn.href = `/compare/?u=${sel.join(',')}`;
    try {
      localStorage.setItem(COMPARE_KEY, JSON.stringify(sel));
    } catch {
      /* ignore */
    }
  }
  cmpBoxes.forEach((c) => c.addEventListener('change', updateCmp));
  updateCmp();

  exportBtn?.addEventListener('click', () => {
    if (picked.length === 0) return;
    const text =
      `我的大学收藏清单（${new Date().toLocaleDateString('zh-CN')}）\n` +
      picked.map((s) => `- ${s.name}（${s.type} · ${s.province} ${s.city}）`).join('\n') +
      '\n来源：象牙塔透视镜 https://localhost:4321';
    navigator.clipboard
      ?.writeText(text)
      .then(() => {
        exportBtn.textContent = '已复制 ✓';
        setTimeout(() => (exportBtn.textContent = '导出收藏'), 1600);
      })
      .catch(() => {});
  });
</script>
