---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UniversityCard from '../../components/UniversityCard.astro';
import { LEVELS } from '../../config';

const universities = (await getCollection('universities')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'zh'),
);
const provinces = [...new Set(universities.map((u) => u.data.province))].sort(
  (a, b) => a.localeCompare(b, 'zh'),
);
const types = [...new Set(universities.map((u) => u.data.type))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);
const allTags = [...new Set(universities.flatMap((u) => u.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);
const REGIONS: Record<string, string> = {
  北京: '华北', 天津: '华北', 河北: '华北', 山西: '华北', 内蒙古: '华北',
  上海: '华东', 江苏: '华东', 浙江: '华东', 安徽: '华东', 福建: '华东',
  江西: '华东', 山东: '华东',
  湖北: '华中', 湖南: '华中', 河南: '华中',
  广东: '华南', 广西: '华南', 海南: '华南',
  重庆: '西南', 四川: '西南', 贵州: '西南', 云南: '西南', 西藏: '西南',
  陕西: '西北', 甘肃: '西北', 青海: '西北', 宁夏: '西北', 新疆: '西北',
  辽宁: '东北', 吉林: '东北', 黑龙江: '东北',
};
const regions = [...new Set(universities.map((u) => REGIONS[u.data.province] ?? '其他'))].filter(Boolean);
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout title="大学库" description="按省份、层次、类型筛选与搜索 985 高校。">
  <div class="container page">
    <div class="page-hero">
      <h1>大学库</h1>
      <p>当前收录 {universities.length} 所 985 高校，每所大学的政策、实况与资料都在详情页里。</p>
      <button class="btn btn-ghost" id="viewToggle" type="button">列表视图</button>
    </div>

    <form class="card filters" id="filters" method="get" action="/universities/">
      <div class="filter-group">
        <input
          type="search"
          id="q"
          name="q"
          placeholder="搜索大学名称 / 标签…"
          value={initialQuery}
          aria-label="搜索大学"
        />
      </div>
      <div class="filter-group">
        <label>
          省份
          <select id="province">
            <option value="">全部省份</option>
            {provinces.map((p) => <option value={p}>{p}</option>)}
          </select>
        </label>
      </div>
      <div class="filter-group">
        <label>
          类型
          <select id="type">
            <option value="">全部类型</option>
            {types.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
      </div>
      <div class="filter-group">
        <label>
          特色标签
          <select id="tagFilter">
            <option value="">全部标签</option>
            {allTags.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
      </div>
      <div class="filter-group">
        <label>
          排序
          <select id="sortBy">
            <option value="name">按名称</option>
            <option value="province">按省份</option>
            <option value="videos">按视频数</option>
            <option value="materials">按资料数</option>
          </select>
        </label>
      </div>
      <div class="filter-group">
        <span class="small muted">层次：</span>
        {LEVELS.map((level) => (
          <label>
            <input type="checkbox" class="level" value={level} />
            {level}
          </label>
        ))}
      </div>
      <div class="filter-group region-chips">
        <span class="small muted">大区：</span>
        <button type="button" class="video-filter-btn active" data-region="all">全部</button>
        {regions.map((r) => (
          <button type="button" class="video-filter-btn" data-region={r}>{r}</button>
        ))}
      </div>
      <div class="filter-group">
        <label>
          <input type="checkbox" id="favOnly" />
          ★ 只看收藏
        </label>
      </div>
      <div class="filter-group">
        <label>
          <input type="checkbox" id="videoOnly" />
          只看有视频
        </label>
      </div>
      <div class="filter-group">
        <label>
          <input type="checkbox" id="materialOnly" />
          只看有资料
        </label>
      </div>
    </form>

    <p class="result-count" id="resultCount">共 {universities.length} 所大学</p>
    <p class="small muted" style="margin-top:-10px;">
      提示：卡片左上角 ★ 可收藏，右上角「对比」可勾选 2-3 所进入对比页。
    </p>

    <div class="grid grid-universities" id="universityGrid">
      {universities.map((u) => (
        <div
          class:list={['u-item']}
          data-name={u.data.name}
          data-tags={[...u.data.levels, ...u.data.tags].join(' ')}
          data-extra-tags={u.data.tags.join(' ')}
          data-province={u.data.province}
          data-type={u.data.type}
          data-levels={u.data.levels.join(' ')}
          data-region={REGIONS[u.data.province] ?? '其他'}
          data-videos={u.data.videos.length}
          data-materials={u.data.materials.length}
        >
          <label class="fav-check" title="收藏该学校">
            <input type="checkbox" class="fav-box" value={u.id} aria-label={`收藏${u.data.name}`} />
            <span>★</span>
          </label>
          <label class="compare-check" title="加入对比">
            <input type="checkbox" class="compare-box" value={u.id} aria-label={`对比${u.data.name}`} />
            <span>对比</span>
          </label>
          <UniversityCard university={u} />
        </div>
      ))}
    </div>

    <p class="muted" id="emptyState" hidden>没有匹配的大学，试试调整搜索或筛选条件。</p>

    <div class="compare-bar" id="compareBar" hidden>
      <span id="compareCount">已选 0 所</span>
      <a class="btn btn-primary" id="compareBtn" href="/compare/?u=">开始对比</a>
    </div>
  </div>
</BaseLayout>

<script>
  const grid = document.getElementById('universityGrid');
  const count = document.getElementById('resultCount');
  const qInput = document.getElementById('q');
  const provinceSelect = document.getElementById('province');
  const typeSelect = document.getElementById('type');
  const tagFilter = document.getElementById('tagFilter');
  const levelChecks = Array.from(document.querySelectorAll('.level'));
  const items = Array.from(grid?.querySelectorAll('.u-item') ?? []);
  const emptyState = document.getElementById('emptyState');
  const compareBar = document.getElementById('compareBar');
  const compareCount = document.getElementById('compareCount');
  const compareBtn = document.getElementById('compareBtn');
  const compareBoxes = Array.from(document.querySelectorAll('.compare-box'));
  const sortSelect = document.getElementById('sortBy');
  const favOnly = document.getElementById('favOnly');
  const videoOnly = document.getElementById('videoOnly');
  const materialOnly = document.getElementById('materialOnly');
  const viewToggle = document.getElementById('viewToggle');
  const regionBtns = Array.from(document.querySelectorAll('[data-region]'));
  const favBoxes = Array.from(document.querySelectorAll('.fav-box'));

  const FAV_KEY = 'fav-universities';
  const COMPARE_KEY = 'compare-list';
  let favs = new Set();
  try {
    favs = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]'));
  } catch {
    favs = new Set();
  }

  favBoxes.forEach((c) => {
    c.checked = favs.has(c.value);
    c.addEventListener('change', () => {
      if (c.checked) favs.add(c.value);
      else favs.delete(c.value);
      try {
        localStorage.setItem(FAV_KEY, JSON.stringify([...favs]));
      } catch {
        /* ignore */
      }
      applyFilters();
    });
  });

  let compareSel = new Set();
  try {
    compareSel = new Set(JSON.parse(localStorage.getItem(COMPARE_KEY) || '[]'));
  } catch {
    compareSel = new Set();
  }
  compareBoxes.forEach((c) => {
    c.checked = compareSel.has(c.value);
  });

  function applyFilters() {
    const keyword = (qInput?.value ?? '').trim().toLowerCase();
    const province = provinceSelect?.value ?? '';
    const type = typeSelect?.value ?? '';
    const tag = tagFilter?.value ?? '';
    const selectedLevels = levelChecks.filter((c) => c.checked).map((c) => c.value);
    const favOnlyChecked = favOnly?.checked ?? false;
    const videoOnlyChecked = videoOnly?.checked ?? false;
    const materialOnlyChecked = materialOnly?.checked ?? false;
    const region = document.querySelector('[data-region].active')?.getAttribute('data-region') ?? 'all';

    let visible = 0;
    for (const item of items) {
      const name = item.dataset.name ?? '';
      const tags = item.dataset.tags ?? '';
      const levels = (item.dataset.levels ?? '').split(' ');
      const okKeyword = !keyword || name.toLowerCase().includes(keyword) || tags.toLowerCase().includes(keyword);
      const okProvince = !province || item.dataset.province === province;
      const okType = !type || item.dataset.type === type;
      const okTag = !tag || (item.dataset.extraTags ?? '').split(' ').includes(tag);
      const okLevel = selectedLevels.length === 0 || selectedLevels.some((l) => levels.includes(l));
      const okFav = !favOnlyChecked || favs.has(item.querySelector('.fav-box')?.value ?? '');
      const okVideo = !videoOnlyChecked || Number(item.dataset.videos ?? 0) > 0;
      const okMaterial = !materialOnlyChecked || Number(item.dataset.materials ?? 0) > 0;
      const okRegion = region === 'all' || item.dataset.region === region;
      const ok = okKeyword && okProvince && okType && okTag && okLevel && okFav && okVideo && okMaterial && okRegion;
      item.style.display = ok ? '' : 'none';
      if (ok) visible++;
    }
    if (count) count.textContent = `共 ${visible} 所大学`;
    if (emptyState) emptyState.hidden = visible !== 0;
  }

  function updateCompare() {
    const selected = compareBoxes.filter((c) => c.checked).map((c) => c.value);
    if (selected.length > 3) {
      const last = selected[selected.length - 1];
      const box = compareBoxes.find((c) => c.value === last);
      if (box) box.checked = false;
      return updateCompare();
    }
    if (compareBar) compareBar.hidden = selected.length < 2;
    if (compareCount) compareCount.textContent = `已选 ${selected.length} 所`;
    if (compareBtn) compareBtn.href = `/compare/?u=${selected.join(',')}`;
    try {
      localStorage.setItem(COMPARE_KEY, JSON.stringify(selected));
    } catch {
      /* ignore */
    }
  }

  function applySort() {
    const mode = sortSelect?.value ?? 'name';
    const sorted = [...items].sort((a, b) => {
      if (mode === 'province') {
        return (a.dataset.province ?? '').localeCompare(b.dataset.province ?? '', 'zh');
      }
      if (mode === 'videos') {
        return Number(b.dataset.videos ?? 0) - Number(a.dataset.videos ?? 0);
      }
      if (mode === 'materials') {
        return Number(b.dataset.materials ?? 0) - Number(a.dataset.materials ?? 0);
      }
      return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'zh');
    });
    sorted.forEach((el) => grid?.appendChild(el));
  }

  qInput?.addEventListener('input', applyFilters);
  provinceSelect?.addEventListener('change', applyFilters);
  typeSelect?.addEventListener('change', applyFilters);
  tagFilter?.addEventListener('change', applyFilters);
  levelChecks.forEach((c) => c.addEventListener('change', applyFilters));
  compareBoxes.forEach((c) => c.addEventListener('change', updateCompare));
  sortSelect?.addEventListener('change', applySort);
  favOnly?.addEventListener('change', applyFilters);
  videoOnly?.addEventListener('change', applyFilters);
  materialOnly?.addEventListener('change', applyFilters);
  regionBtns.forEach((b) => {
    b.addEventListener('click', () => {
      regionBtns.forEach((x) => {
        x.classList.toggle('active', x === b);
        x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
      });
      applyFilters();
    });
  });
  viewToggle?.addEventListener('click', () => {
    const listMode = grid?.classList.toggle('list-view') ?? false;
    if (viewToggle) viewToggle.textContent = listMode ? '卡片视图' : '列表视图';
    try {
      localStorage.setItem('uni-view', listMode ? 'list' : 'card');
    } catch {
      /* ignore */
    }
  });
  try {
    if (localStorage.getItem('uni-view') === 'list' && grid && viewToggle) {
      grid.classList.add('list-view');
      viewToggle.textContent = '卡片视图';
    }
  } catch {
    /* ignore */
  }
  applyFilters();
  applySort();
  updateCompare();
</script>
