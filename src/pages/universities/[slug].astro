---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import UniversityCard from '../../components/UniversityCard.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { RESOURCE_CATEGORIES, SECTIONS, SITE } from '../../config';

export async function getStaticPaths() {
  const universities = await getCollection('universities');
  return universities.map((u) => ({
    params: { slug: u.id },
    props: { university: u },
  }));
}

const { university } = Astro.props;
const u = university.data;
const { Content } = await render(university);

const tabs = [
  { id: 'overview', label: '概况' },
  ...(u.transferPolicy ? [{ id: 'transfer', label: '转专业' }] : []),
  ...(u.secondarySelection ? [{ id: 'secondary', label: '二次选拔' }] : []),
  ...(u.trainingPlan ? [{ id: 'training', label: '培养计划' }] : []),
  ...(u.dorm ? [{ id: 'dorm', label: '寝室' }] : []),
  ...(u.classes ? [{ id: 'classes', label: '上课' }] : []),
  ...(u.materials.length ? [{ id: 'materials', label: '学习资料' }] : []),
  ...(u.videos.length ? [{ id: 'videos', label: '视频' }] : []),
];

const materialsByCategory = RESOURCE_CATEGORIES.map((c) => ({
  ...c,
  items: u.materials.filter((m) => m.category === c.id),
})).filter((c) => c.items.length > 0);

const hasCloudMaterials = u.materials.some((m) => m.link.includes('pan.'));

const missingSections = SECTIONS.filter((s) => {
  if (s.id === 'transfer') return !u.transferPolicy;
  if (s.id === 'secondary') return !u.secondarySelection;
  if (s.id === 'training') return !u.trainingPlan;
  if (s.id === 'dorm') return !u.dorm;
  if (s.id === 'classes') return !u.classes;
  if (s.id === 'materials') return u.materials.length === 0;
  if (s.id === 'videos') return u.videos.length === 0;
  return false;
});

const allUniversities = await getCollection('universities');
const withVideosCount = allUniversities.filter((x) => x.data.videos.length > 0).length;
const withMaterialsCount = allUniversities.filter((x) => x.data.materials.length > 0).length;
const TAG_ORDER = { 宣传片: 0, 宿舍生活: 1, 学习日常: 2 };
const sortedVideos = [...u.videos].sort(
  (a, b) =>
    (TAG_ORDER[a.tags?.[0]] ?? 9) - (TAG_ORDER[b.tags?.[0]] ?? 9),
);
const related = allUniversities
  .filter((x) => x.id !== university.id)
  .sort((a, b) => {
    const aScore = (a.data.province === u.province ? 2 : 0) + (a.data.type === u.type ? 1 : 0);
    const bScore = (b.data.province === u.province ? 2 : 0) + (b.data.type === u.type ? 1 : 0);
    return bScore - aScore;
  })
  .slice(0, 3);
---

<BaseLayout
  title={u.name}
  description={`${u.name}（${u.nameEn ?? ''}）概况、转专业政策、二次选拔、培养计划、寝室与上课实况、学习资料。`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollegeOrUniversity',
    name: u.name,
    alternateName: u.nameEn ?? undefined,
    url: `${SITE.url.replace(/\/$/, '')}/universities/${university.id}/`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: u.city,
      addressRegion: u.province,
    },
    memberOf: u.levels,
  })}></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE.url.replace(/\/$/, '')}/` },
      { '@type': 'ListItem', position: 2, name: '大学库', item: `${SITE.url.replace(/\/$/, '')}/universities/` },
      { '@type': 'ListItem', position: 3, name: u.name },
    ],
  })}></script>
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <a href="/universities/">大学库</a> › <span>{u.name}</span>
    </nav>
    <div class="uni-hero">
      <img class="uni-emblem" src={u.cover} alt={`${u.name} 校徽`} loading="eager" width="96" height="96" />
      <div class="uni-hero-info">
      <h1>{u.name}</h1>
      <button class="fav-btn" id="favBtn" type="button" aria-pressed="false">☆ 收藏</button>
      <a class="btn btn-ghost report-btn" href={`/submit/?school=${encodeURIComponent(u.name)}`}>
        ✎ 纠错 / 补充此页
      </a>
      <button class="btn btn-ghost" id="detailCompareBtn" type="button" data-slug={university.id}>
        ＋ 加入对比
      </button>
      <a class="btn btn-primary" id="detailCompareLink" href="/compare/" hidden>去对比 →</a>
      {u.nameEn && <div class="uni-en">{u.nameEn}</div>}
      <div class="chip-row">
        {u.levels.map((level) => <span class={`chip level-${level}`}>{level}</span>)}
        {u.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
      <div class="university-meta">
        <span>{u.province} · {u.city}</span>
        <span>{u.type}类</span>
        {u.established && <span>建校 {u.established} 年</span>}
      </div>
      {u.campuses.length > 0 && (
        <div class="university-meta">校区：{u.campuses.join(' / ')}</div>
      )}
      </div>
    </div>

    <div class="note-banner">
      ℹ️ 内容持续整理中，部分栏目待补充；政策类信息请以高校官方发布为准。
    </div>

    <nav class="uni-tabs" aria-label="栏目导航">
      {tabs.map((tab) => (
        <a href={`#${tab.id}`}>{tab.label}</a>
      ))}
    </nav>

    <section id="overview" class="card section-block">
      <h2>学校概况</h2>
      <div class="prose">
        <Content />
      </div>
    </section>

    {u.transferPolicy && (
      <SectionBlock
        id="transfer"
        title="转专业政策"
        summary={u.transferPolicy.summary}
        items={u.transferPolicy.points}
        sources={u.transferPolicy.sources}
      />
    )}

    {u.secondarySelection && (
      <section id="secondary" class="card section-block">
        <h2>二次选拔</h2>
        {u.secondarySelection.summary && <p>{u.secondarySelection.summary}</p>}
        <ul class="point-list">
          {u.secondarySelection.programs.map((p) => (
            <li class="point-item">
              <strong>{p.name}</strong>
              <p>{p.content}</p>
            </li>
          ))}
        </ul>
        {u.secondarySelection.sources.length > 0 && (
          <div class="sources">
            信息来源：
            <ul>
              {u.secondarySelection.sources.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        )}
      </section>
    )}

    {u.trainingPlan && (
      <SectionBlock
        id="training"
        title="专业培养计划"
        summary={u.trainingPlan.summary}
        items={u.trainingPlan.points}
        sources={u.trainingPlan.sources}
      />
    )}

    {u.dorm && (
      <section id="dorm" class="card section-block">
        <h2>寝室情况</h2>
        {u.dorm.summary && <p>{u.dorm.summary}</p>}
        <ul class="point-list">
          {u.dorm.items.map((item) => (
            <li class="point-item">
              <strong>{item.name}</strong>
              <p>{item.content}</p>
            </li>
          ))}
        </ul>
        {u.dorm.sources.length > 0 && (
          <div class="sources">
            信息来源：
            <ul>
              {u.dorm.sources.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        )}
      </section>
    )}

    {u.classes && (
      <SectionBlock
        id="classes"
        title="上课情况"
        summary={u.classes.summary}
        items={u.classes.points}
        sources={u.classes.sources}
      />
    )}

    {u.materials.length > 0 && (
      <section id="materials" class="card section-block">
        <h2>学习资料</h2>
        {hasCloudMaterials && (
          <div class="note-banner">
            🗂️ 部分资料存放于网盘：点击"获取资料"打开网盘，输入对应提取码即可查看或下载。
          </div>
        )}
        {materialsByCategory.map((cat) => (
          <div style="margin-bottom: 22px;">
            <h3 style="font-size:16px;margin:18px 0 10px;">{cat.label}</h3>
            <div
              class="grid"
              style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));"
            >
              {cat.items.map((m) => (
                <div class="card material-card">
                  <div class="title-row">
                    <h3>{m.title}</h3>
                    <span class="type-chip">{m.type}</span>
                  </div>
                  <p>{m.description}</p>
                  {m.code && <p>提取码：<strong>{m.code}</strong></p>}
                  <a class="btn" href={m.link} target="_blank" rel="noopener">
                    {m.link.startsWith('/') ? '查看文件' : '获取资料'}
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))}
        <p class="small muted">
          全部学校资料统一收录于 <a href="/resources/">资料库</a>，欢迎投稿补充。
        </p>
      </section>
    )}

    {u.videos.length > 0 && (
      <section id="videos" class="section">
        <div class="section-head">
          <h2>视频</h2>
        </div>
        <div class="grid grid-videos">
          {sortedVideos.map((video) => <VideoEmbed video={video} />)}
        </div>
      </section>
    )}

    {missingSections.length > 0 && (
      <section class="card section-block">
        <h2>待补充信息</h2>
        <p class="small muted" style="margin:0 0 10px;">
          全站进度：学校概况 {allUniversities.length}/{allUniversities.length} · 校园/政策视频 {withVideosCount}/{allUniversities.length} · 学习资料 {withMaterialsCount}/{allUniversities.length}
        </p>
        <p>
          以下栏目尚未收录内容，欢迎
          <a href="/submit/">投稿</a>补充一手信息（政策原文、实拍、资料等）：
        </p>
        <div class="chip-row">
          {missingSections.map((s) => (
            <a class="chip" href="/submit/" style="text-decoration:none;">
              ＋ {s.label}
            </a>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="card section-block">
        <div class="section-head">
          <h2>相关学校</h2>
          <a class="more" href="/universities/">查看全部 →</a>
        </div>
        <div class="grid grid-universities">
          {related.map((r) => <UniversityCard university={r} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<script>
  const RECENT_KEY = 'recent-universities';
  try {
    const recent = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    const next = [slug, ...recent.filter((x) => x !== slug)].slice(0, 6);
    localStorage.setItem(RECENT_KEY, JSON.stringify(next));
  } catch {
    /* ignore */
  }

  const favBtn = document.getElementById('favBtn');
  const FAV_KEY = 'fav-universities';
  const slug = window.location.pathname.split('/').filter(Boolean)[1] ?? '';
  let favs = new Set();
  try {
    favs = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]'));
  } catch {
    favs = new Set();
  }
  if (favBtn) {
    const refresh = () => {
      const has = favs.has(slug);
      favBtn.textContent = has ? '★ 已收藏' : '☆ 收藏';
      favBtn.setAttribute('aria-pressed', has ? 'true' : 'false');
    };
    favBtn.addEventListener('click', () => {
      if (favs.has(slug)) favs.delete(slug);
      else favs.add(slug);
      try {
        localStorage.setItem(FAV_KEY, JSON.stringify([...favs]));
      } catch {
        /* ignore */
      }
      refresh();
    });
    refresh();
  }

  const tabs = Array.from(document.querySelectorAll('.uni-tabs a'));
  const sections = tabs
    .map((a) => document.getElementById((a.getAttribute('href') ?? '').slice(1)))
    .filter(Boolean);
  function onScroll() {
    let current = sections[0];
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= 130) current = s;
    }
    tabs.forEach((a) => {
      a.classList.toggle('active', a.getAttribute('href') === `#${current?.id}`);
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const cmpBtn = document.getElementById('detailCompareBtn');
  const cmpLink = document.getElementById('detailCompareLink');
  const COMPARE_KEY = 'compare-list';
  let cmpList = [];
  try {
    cmpList = JSON.parse(localStorage.getItem(COMPARE_KEY) || '[]');
  } catch {
    cmpList = [];
  }
  const cmpSlug = cmpBtn?.dataset.slug;

  function updateCmp() {
    if (!cmpBtn) return;
    const inList = cmpSlug && cmpList.includes(cmpSlug);
    cmpBtn.textContent = inList ? `已加入对比 (${cmpList.length}/3)` : '＋ 加入对比';
    if (cmpLink) {
      cmpLink.hidden = cmpList.length < 2;
      cmpLink.href = `/compare/?u=${cmpList.join(',')}`;
    }
  }

  cmpBtn?.addEventListener('click', () => {
    if (!cmpSlug) return;
    if (cmpList.includes(cmpSlug)) {
      cmpList = cmpList.filter((x) => x !== cmpSlug);
    } else {
      if (cmpList.length >= 3) cmpList.shift();
      cmpList.push(cmpSlug);
    }
    try {
      localStorage.setItem(COMPARE_KEY, JSON.stringify(cmpList));
    } catch {
      /* ignore */
    }
    updateCmp();
  });
  updateCmp();
</script>
