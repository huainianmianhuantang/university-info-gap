  const REGION_COLORS = {
    light: { 华北:'#dbe9ff', 华东:'#d9f2e4', 华中:'#e6ddf5', 华南:'#fde3ea', 西南:'#f4ead2', 西北:'#e3ebf4', 东北:'#dde8f0' },
    dark: { 华北:'#24406b', 华东:'#244f44', 华中:'#4a3a63', 华南:'#5b3a52', 西南:'#4a4630', 西北:'#3b4a5b', 东北:'#35495e' }
  };
  function geoRegions(region: string): any[] {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    const pal = REGION_COLORS[dark ? 'dark' : 'light'];
    const dim = dark ? '#101a2c' : '#eef2f8';
    const base = dark ? '#1a2740' : '#eaf1fb';
    const out: any[] = [];
    for (const p in PROV_FULL) {
      let r: string | null = null;
      for (const rk in REGION_PROVS) {
        if (REGION_PROVS[rk].indexOf(p) !== -1) { r = rk; break; }
      }
      const isSel = region === '全部' || r === region;
      out.push({ name: PROV_FULL[p], itemStyle: { areaColor: isSel ? (r ? (pal as any)[r] : base) : dim, opacity: isSel ? 1 : 0.45 } });
    }
    return out;
  }

  function themeColors() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    return dark
      ? { area:'#1a2740', border:'#2b3b57', hover:'#27406b', dim:'#101a2c', tooltipBg:'#16213a', tooltipColor:'#e5edf8', mute:'#9db0c8', label:'#8fa6c8', labelStrong:'#e5edf8' }
      : { area:'#eaf1fb', border:'#b9cbea', hover:'#d9e7ff', dim:'#eef2f8', tooltipBg:'#ffffff', tooltipColor:'#1e293b', mute:'#5b6b84', label:'#7c8ba5', labelStrong:'#12336e' };
  }

  function buildItems(list: any[]) {
    return list.map((s) => ({
      name: s.name,
      value: [s.lng, s.lat],
      school: s,
      symbol: symbolFor(s.emoji),
      symbolSize: 34
    }));
  }

  function applyFilter(region: string) {
    currentRegion = region;
    document.querySelectorAll('#m985Filters .m985-chip').forEach((b) => {
      b.classList.toggle('active', (b as HTMLElement).dataset.region === region);
    });
    const stat = document.getElementById('m985Stat') as HTMLElement | null;
    const list = region === '全部' ? SCHOOLS : SCHOOLS.filter((s) => s.region === region);
    if (stat) stat.textContent = region + ' ' + list.length + ' 所 / 共 ' + SCHOOLS.length + ' 所';
    if (chart) {
      chart.setOption({
        geo: { regions: geoRegions(region) },
        series: [{ data: buildItems(list) }]
      });
    }
  }

  function initMap(geoJson: any) {
    const el = document.getElementById('m985Map');
    if (!el || !(window as any).echarts) return;
    const old = (window as any).echarts.getInstanceByDom(el);
    if (old) (window as any).echarts.dispose(old);
    const c = themeColors();
    (window as any).echarts.registerMap('china', geoJson);
    chart = (window as any).echarts.init(el);
    chart.setOption({
      tooltip: {
        trigger: 'item',
        backgroundColor: c.tooltipBg,
        borderColor: c.border,
        textStyle: { color: c.tooltipColor, fontSize: 13 },
        formatter: (p: any) => {
          const s = p.data && p.data.school;
          if (!s) return p.name;
          return '<b>' + s.emoji + ' ' + esc(s.name) + '</b><br/>'
            + esc(s.city) + ' · ' + esc(s.region) + '<br/>'
            + '<span style="color:' + c.mute + '">点击查看资料库</span>';
        }
      },
      geo: {
        map: 'china',
        roam: true,
        zoom: 1.12,
        center: [104.5, 36.2],
        label: { show: true, fontSize: 10, color: c.label },
        itemStyle: { areaColor: c.area, borderColor: c.border, borderWidth: 0.8 },
        emphasis: { itemStyle: { areaColor: c.hover }, label: { show: true, fontSize: 11, color: c.labelStrong, fontWeight: 600 } },
        regions: geoRegions(currentRegion)
      },
      series: [{
        type: 'scatter',
        coordinateSystem: 'geo',
        data: buildItems(currentRegion === '全部' ? SCHOOLS : SCHOOLS.filter((s) => s.region === currentRegion)),
        symbolSize: 34,
        emphasis: { scale: 1.3 },
        itemStyle: { shadowBlur: 8, shadowColor: 'rgba(31, 94, 255, 0.35)' },
        label: { show: false },
        zlevel: 3
      }]
    });
    chart.on('click', (params: any) => {
      const s = params.data && params.data.school;
      if (s) openPanel(s);
    });
  }

  function applyThemeToChart() {
    if (!chart) return;
    const c = themeColors();
    chart.setOption({
      tooltip: { backgroundColor: c.tooltipBg, borderColor: c.border, textStyle: { color: c.tooltipColor } },
      geo: {
        itemStyle: { areaColor: c.area, borderColor: c.border },
        label: { show: true, fontSize: 10, color: c.label },
        emphasis: { itemStyle: { areaColor: c.hover }, label: { show: true, fontSize: 11, color: c.labelStrong, fontWeight: 600 } },
        regions: geoRegions(currentRegion)
      }
    });
    buildLegend();
  }

  function openPanel(s: any) {
    document.getElementById('m985Emoji')!.textContent = s.emoji;
    document.getElementById('m985Name')!.textContent = s.name;
    document.getElementById('m985Meta')!.textContent = s.city + ' · ' + s.region + '地区 · ' + s.province;
    const body = document.getElementById('m985Body')!;
    const easter = EASTER_LINES[Math.floor(Math.random() * EASTER_LINES.length)];
    const nickHtml = s.nick || s.fun
      ? sec('🎭 学校昵称 · 冷知识', '<p><b>' + esc(s.nick || s.name) + '</b>' + (s.fun ? ' · ' + esc(s.fun) : '') + '</p>')
      : '';
    body.innerHTML =
      '<div class="m985-easter">✨ ' + esc(easter) + '</div>' +
      sec('📝 学校简介', '<p>' + esc(s.intro) + '</p>') +
      nickHtml +
      sec('🎯 培养特色', '<p>' + esc(s.feature) + '</p>') +
      sec('⭐ 优势学科', '<div class="m985-chips">' + s.majors.map((m: string) => '<span>' + esc(m) + '</span>').join('') + '</div>') +
      sec('🏫 校园生活提示', '<p>' + esc(s.life) + '</p>') +
      sec('🎟️ 报考相关信息', '<p>' + esc(s.apply) + '</p>') +
      '<p style="font-size:11.5px;color:var(--text-secondary)">内容为公开资料整理，仅供信息参考，请以各校官方发布为准。</p>';
    document.getElementById('m985Panel')!.classList.add('open');
    document.getElementById('m985Mask')!.hidden = false;
  }
  function sec(title: string, html: string): string {
    return '<section class="m985-sec"><h4>' + title + '</h4>' + html + '</section>';
  }
  function closePanel() {
    document.getElementById('m985Panel')!.classList.remove('open');
    document.getElementById('m985Mask')!.hidden = true;
  }
  function openFlip() {
    const pool = currentRegion === '全部' ? SCHOOLS : SCHOOLS.filter((s) => s.region === currentRegion);
    const s = pool[Math.floor(Math.random() * pool.length)];
    openPanel(s);
    let count = 0;
    try { count = Number(localStorage.getItem('m985-flips') || '0'); } catch { /* ignore */ }
    count += 1;
    try { localStorage.setItem('m985-flips', String(count)); } catch { /* ignore */ }
    const fc = document.getElementById('m985FlipCount');
    if (fc) fc.textContent = '🎲 已翻牌 ' + count + ' 次';
    const banner = document.createElement('div');
    banner.className = 'm985-flip-banner';
    banner.textContent = '🎲 今日翻牌：' + s.emoji + ' ' + s.name + '（' + s.city + '）——缘分到了就是它！';
    const body = document.getElementById('m985Body')!;
    if (body.firstChild) body.insertBefore(banner, body.firstChild);
    else body.appendChild(banner);
  }
  function initFlip() {
    try {
      const n = Number(localStorage.getItem('m985-flips') || '0');
      const fc = document.getElementById('m985FlipCount');
      if (fc && n > 0) fc.textContent = '🎲 已翻牌 ' + n + ' 次';
    } catch { /* ignore */ }
  }

  function buildFilters() {
    const wrap = document.getElementById('m985Filters');
    if (!wrap) return;
    wrap.innerHTML = '';
    ['全部', '华北', '华东', '华中', '华南', '西南', '西北', '东北'].forEach((r) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'm985-chip' + (r === currentRegion ? ' active' : '');
      b.dataset.region = r;
      const n = r === '全部' ? SCHOOLS.length : SCHOOLS.filter((s) => s.region === r).length;
      b.textContent = r + ' (' + n + ')';
      b.addEventListener('click', () => applyFilter(r));
      wrap.appendChild(b);
    });
    const flip = document.createElement('button');
    flip.type = 'button';
    flip.className = 'm985-chip';
    flip.id = 'm985FlipBtn';
    flip.textContent = '🎲 随机翻牌';
    flip.addEventListener('click', openFlip);
    wrap.appendChild(flip);
    const stat = document.createElement('span');
    stat.className = 'm985-stat';
    stat.id = 'm985Stat';
    stat.textContent = '共 ' + SCHOOLS.length + ' 所';
    wrap.appendChild(stat);
  }
  function buildLegend() {
    const el = document.getElementById('m985Legend');
    if (!el) return;
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    const pal = REGION_COLORS[dark ? 'dark' : 'light'];
    el.innerHTML = '';
    ['华北','华东','华中','华南','西南','西北','东北'].forEach((r) => {
      const s = document.createElement('span');
      s.innerHTML = '<i style="background:' + (pal as any)[r] + '"></i>' + r;
      el.appendChild(s);
    });
  }

