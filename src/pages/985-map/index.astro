    '中山':'中山大学','华工':'华南理工大学','川大':'四川大学','电子科大':'电子科技大学','重大':'重庆大学',
    '西交':'西安交通大学','西交大':'西安交通大学','西工大':'西北工业大学','西农':'西北农林科技大学',
    '兰大':'兰州大学','哈工大':'哈尔滨工业大学','吉大':'吉林大学','大工':'大连理工大学'
  };
  const BOT_MAJOR_KEYWORDS = [
    { k:'计算机', words:['计算机','软件'] },
    { k:'电子信息', words:['电子','通信','集成电路','信息'] },
    { k:'工科', words:['机械','电气','自动化','材料','土木','建筑','化工','车辆','能源','交通','船舶','航空','航天','冶金'] },
    { k:'医学', words:['临床医学','口腔','药学','基础医学','公共卫生','护理'] },
    { k:'口腔', words:['口腔'] },
    { k:'经管', words:['经济','金融','工商管理','会计','管理'] },
    { k:'法学', words:['法学'] },
    { k:'人文社科', words:['中文','历史','哲学','新闻','教育','心理','外语','社会学'] },
    { k:'师范教育', words:['教育学','师范'] },
    { k:'农学', words:['农学','园艺','植物','食品','动物','林学'] },
    { k:'海洋', words:['海洋'] },
    { k:'建筑', words:['建筑'] },
    { k:'航空航天', words:['航空','航天','宇航'] },
    { k:'理科基础', words:['数学','物理','化学','生物','天文','地质','统计'] }
  ];
  const PROVS_ALL = ['北京','天津','上海','江苏','浙江','安徽','福建','江西','山东','湖北','湖南','河南','广东','广西','海南','四川','重庆','贵州','云南','陕西','甘肃','青海','宁夏','新疆','辽宁','吉林','黑龙江','河北','山西','内蒙古'];

  function botAdd(text: string, who: string) {
    const msgs = document.getElementById('mbotMsgs')!;
    const d = document.createElement('div');
    d.className = 'mbot-msg ' + who;
    d.textContent = text;
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  }
  function botAddSchools(text: string, list: any[]) {
    const msgs = document.getElementById('mbotMsgs')!;
    const wrap = document.createElement('div');
    wrap.className = 'mbot-msg mbot-bot';
    const p = document.createElement('div');
    p.textContent = text;
    wrap.appendChild(p);
    list.slice(0, 8).forEach((s) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'mbot-school';
      b.textContent = s.emoji + ' ' + s.name;
      b.addEventListener('click', () => { openPanel(s); closeBot(); });
      wrap.appendChild(b);
    });
    msgs.appendChild(wrap);
    msgs.scrollTop = msgs.scrollHeight;
  }
  function schoolByName(text: string): any {
    for (const key in BOT_ALIAS) {
      if (text.indexOf(key) !== -1) {
        const hit = SCHOOLS.find((s) => s.name === BOT_ALIAS[key]);
        if (hit) return hit;
      }
    }
    return SCHOOLS.find((s) => text.indexOf(s.name) !== -1) || null;
  }
  async function askLLM(t: string): Promise<string | null> {
    try {
      const res = await fetch('/api/assistant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: [{ role: 'user', content: '985 高校地图问答：' + t }] }),
      });
      const data = await res.json();
      if (res.ok && data.reply) return String(data.reply);
    } catch { /* ignore */ }
    return null;
  }
  function askBot(text: string) {
    const t = (text || '').trim();
    if (!t) return;
    botAdd(t, 'mbot-me');

    const s = schoolByName(t);
    if (s && /怎么样|如何|介绍|在哪|什么学校|聊聊/.test(t)) {
      botAddSchools('这所学校的档案我熟：', [s]);
      if (s.nick) botAdd('🎭 昵称：' + s.nick, 'mbot-bot');
      if (s.fun) botAdd('💡 冷知识：' + s.fun, 'mbot-bot');
      botAdd('点击上面卡片即可打开完整资料库～', 'mbot-bot');
      return;
    }

    const regionHit = ['华北','华东','华中','华南','西南','西北','东北'].filter((r) => t.indexOf(r) !== -1);
    if (regionHit.length) {
      const list = SCHOOLS.filter((x) => x.region === regionHit[0]);
      botAddSchools(regionHit[0] + '地区共有 ' + list.length + ' 所 985：', list);
      return;
    }

    const provHit = PROVS_ALL.filter((p) => t.indexOf(p) !== -1)[0];
    if (provHit) {
      const plist = SCHOOLS.filter((x) => x.province === provHit);
      botAddSchools(provHit + '共有 ' + plist.length + ' 所 985：', plist);
      return;
    }

    for (const mk of BOT_MAJOR_KEYWORDS) {
      if (mk.words.some((w) => t.indexOf(w) !== -1)) {
        const mlist = SCHOOLS.filter((x) => mk.words.some((w) => (x.majors || []).join(' ').indexOf(w) !== -1));
        if (mlist.length) {
          botAddSchools('「' + mk.k + '」方向值得关注的 985：', mlist);
          return;
        }
      }
    }

    if (t.indexOf('随机') !== -1 || t.indexOf('推荐') !== -1 || t.indexOf('翻牌') !== -1) {
      const r = SCHOOLS[Math.floor(Math.random() * SCHOOLS.length)];
      botAddSchools('帮你翻一张牌，缘分到了就是它：', [r]);
      return;
    }

    if (t.indexOf('有哪些985') !== -1 || t.indexOf('全部') !== -1 || t.indexOf('所有') !== -1 || t.indexOf('985') !== -1) {
      botAddSchools('全国共有 39 所 985（先列 8 所）：', SCHOOLS);
      return;
    }

    // 未命中：站内版接 DeepSeek 增强，失败则友好降级
    botAdd('让我想想…', 'mbot-bot');
    askLLM(t).then((reply) => {
      if (reply) {
        botAdd(reply, 'mbot-bot');
      } else {
        botAdd('这个问题我还没学会 😅 试试这些问法：', 'mbot-bot');
        botAdd('· 北京有哪些985？\n· 推荐几所计算机强校\n· 口腔医学哪家强\n· 川大怎么样\n· 🎲 随机推荐一所', 'mbot-bot');
      }
    });
  }
  function closeBot() {
    document.getElementById('mbotCard')!.hidden = true;
  }
  function toggleBot() {
    const card = document.getElementById('mbotCard')!;
    card.hidden = !card.hidden;
    if (!card.hidden) (document.getElementById('mbotInput') as HTMLInputElement).focus();
  }
  function initBot() {
    ['北京有哪些985？','推荐几所计算机强校','口腔医学哪家强','川大怎么样？','🎲 随机推荐一所'].forEach((c) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'mbot-chip';
      b.textContent = c;
      b.addEventListener('click', () => askBot(c));
      document.getElementById('mbotChips')!.appendChild(b);
    });
    document.getElementById('mbotFab')!.addEventListener('click', toggleBot);
    document.getElementById('mbotClose')!.addEventListener('click', closeBot);
    document.getElementById('mbotSend')!.addEventListener('click', () => {
      const input = document.getElementById('mbotInput') as HTMLInputElement;
      askBot(input.value);
      input.value = '';
    });
    const input = document.getElementById('mbotInput') as HTMLInputElement;
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        askBot(input.value);
        input.value = '';
      }
    });
    botAdd('你好呀，我是 985 地图小导游 🤖', 'mbot-bot');
    botAdd('可以问我：北京有哪些985？推荐几所计算机强校？口腔医学哪家强？川大怎么样？', 'mbot-bot');
  }

  function initMapPage() {
    const root = document.getElementById('m985Map');
    if (!root || root.dataset.appInit === '1') return;
    root.dataset.appInit = '1';

    const loading = document.getElementById('m985Loading') as HTMLElement;
    const errorBox = document.getElementById('m985Error') as HTMLElement;
    function setStage(t: string) {
      loading.innerHTML = '⏳ ' + t;
    }
    function showError() {
      loading.hidden = true;
      errorBox.hidden = false;
    }
    function addPreconnects() {
      ['https://cdn.jsdelivr.net', 'https://unpkg.com', 'https://geo.datav.aliyun.com', 'https://cdnjs.cloudflare.com'].forEach((h) => {
        if (!document.querySelector('link[rel="preconnect"][href="' + h + '"]')) {
          const l = document.createElement('link');
          l.rel = 'preconnect';
          l.href = h;
          document.head.appendChild(l);
        }
      });
    }
    function loadMapData(): Promise<any> {
      try {
        const cached = sessionStorage.getItem('m985-geo-v1');
        if (cached) {
          const j = JSON.parse(cached);
          if (j && j.features) return Promise.resolve(j);
        }
      } catch { /* ignore */ }
      // 优先使用体积更小的省界精简版，DataV 全量版作为后备
      const urls = [
        'https://cdn.jsdelivr.net/npm/echarts@4.9.0/map/json/china.json',
        'https://unpkg.com/echarts@4.9.0/map/json/china.json',
        'https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json'
      ];
      return urls.reduce(
        (p, u) => p.catch(() => loadJSON(u).then((j) => {
          if (j && j.features) {
            try { sessionStorage.setItem('m985-geo-v1', JSON.stringify(j)); } catch { /* ignore */ }
          }
          return j;
        })),
        Promise.reject(new Error('start')),
      );
    }
    function loadEcharts(): Promise<void> {
      const urls = [
        'https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js',
        'https://unpkg.com/echarts@5.5.1/dist/echarts.min.js',
        'https://cdnjs.cloudflare.com/ajax/libs/echarts/5.5.1/echarts.min.js'
      ];
      return urls.reduce(
        (p, u) => p.catch(() => loadScript(u)),
        Promise.reject(new Error('start')),
      );
    }
    function boot() {
      loading.hidden = false;
      errorBox.hidden = true;
      addPreconnects();
      setStage('正在加载地图组件…');
      const pEcharts = (window as any).echarts ? Promise.resolve() : loadEcharts();
      const pGeo = loadMapData().then((geo) => {
        setStage('学校数据已就绪，正在绘制…');
        return geo;
      });
      Promise.all([pEcharts, pGeo])
        .then((res) => {
          setStage('正在绘制学校点位…');
          loading.hidden = true;
          initMap(res[1]);
        })
        .catch((err) => {
          console.error(err);
          showError();
        });
    }
    document.getElementById('m985Retry')?.addEventListener('click', boot);
    document.getElementById('m985Close')?.addEventListener('click', closePanel);
    document.getElementById('m985Mask')?.addEventListener('click', closePanel);
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closePanel();
    };
    document.removeEventListener('keydown', onKey);
    document.addEventListener('keydown', onKey);
    const onResize = () => chart && chart.resize();
    window.removeEventListener('resize', onResize);
    window.addEventListener('resize', onResize);

    // 深浅色主题变化时同步地图配色
    if ((window as any).__m985Obs) (window as any).__m985Obs.disconnect();
    (window as any).__m985Obs = new MutationObserver(applyThemeToChart);
    (window as any).__m985Obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    buildFilters();
    buildLegend();
    initBot();
    initFlip();
    boot();
  }

  appWin.__appReady?.(initMapPage);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMapPage);
  } else {
    initMapPage();
  }
</script>
