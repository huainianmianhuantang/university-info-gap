---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="985高校地图"
  description="全国 39 所 985 高校信息交互地图：点击学校图标查看资料库，按地区筛选，帮你在填报前看清每所大学。"
>
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <span>985高校地图</span>
    </nav>

    <nav class="m985-filters" id="m985Filters" aria-label="地区筛选"></nav>

    <div class="m985-legend" id="m985Legend"></div>

    <div class="m985-card">
      <div id="m985Map"></div>
      <div class="m985-loading" id="m985Loading">⏳ 正在加载中国地图与学校点位…</div>
      <div class="m985-error" id="m985Error" hidden>
        <b>😵 地图资源加载失败</b>
        <span>请检查网络后重试（地图组件来自开源 CDN）。</span>
        <button id="m985Retry" type="button">重新加载</button>
      </div>
    </div>
    <p class="m985-note">
      点击地图上的学校图标查看资料库；数据为公开资料整理，仅供信息参考，请以各校官方发布为准
      <span id="m985FlipCount" style="margin-left:8px"></span>
    </p>
  </div>

  <div class="m985-mask" id="m985Mask" hidden></div>
  <aside class="m985-panel" id="m985Panel" role="dialog" aria-modal="false" aria-label="高校资料库">
    <div class="m985-panel-head">
      <span class="m985-panel-emoji" id="m985Emoji"></span>
      <div>
        <h2 id="m985Name"></h2>
        <p id="m985Meta"></p>
      </div>
      <button class="m985-close" id="m985Close" type="button" aria-label="关闭">×</button>
    </div>
    <div class="m985-panel-body" id="m985Body"></div>
  </aside>

  <button class="mbot-fab" id="mbotFab" type="button" aria-label="AI 机器人答疑">🤖</button>
  <div class="mbot-card" id="mbotCard" hidden>
    <div class="mbot-head">
      <span style="font-size:22px">🤖</span>
      <div>
        <b>985 地图小导游</b>
        <div>问我：哪些985、专业强校、某校怎么样</div>
      </div>
      <button class="mbot-close" id="mbotClose" type="button" aria-label="关闭">×</button>
    </div>
    <div class="mbot-chips" id="mbotChips"></div>
    <div class="mbot-msgs" id="mbotMsgs"></div>
    <div class="mbot-input-row">
      <input id="mbotInput" type="text" placeholder="例如：北京有哪些985？" autocomplete="off" />
      <button id="mbotSend" type="button">发送</button>
    </div>
  </div>
</BaseLayout>

<style>
  .m985-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 4px 0 14px;
  }
  .m985-chip {
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text);
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .m985-chip:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
  }
  .m985-chip.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 4px 12px rgba(31, 94, 255, 0.28);
  }
  .m985-stat {
    font-size: 12.5px;
    color: var(--text-secondary);
    margin-left: 6px;
  }
  .m985-card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .m985-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 12%, rgba(31, 94, 255, 0.07), transparent 42%),
      radial-gradient(circle at 86% 82%, rgba(10, 165, 181, 0.07), transparent 46%),
      radial-gradient(rgba(31, 94, 255, 0.10) 1px, transparent 1.6px);
    background-size: auto, auto, 26px 26px;
  }
  #m985Map {
    position: relative;
    z-index: 1;
    width: 100%;
    height: calc(100vh - 200px);
    min-height: 480px;
  }
  .m985-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    justify-content: center;
    margin: 0 0 10px;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .m985-legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 5px;
    vertical-align: -1px;
  }
  .m985-loading,
  .m985-error {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }
  .m985-error b {
    color: var(--danger);
  }
  .m985-error button {
    margin-top: 6px;
    border: 0;
    background: var(--primary);
    color: #fff;
    padding: 8px 18px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 13px;
  }
  .m985-note {
    margin: 12px 0 4px;
    font-size: 12.5px;
    color: var(--text-secondary);
    text-align: center;
  }
  .m985-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 94vw);
    background: var(--card-bg);
    box-shadow: var(--shadow-lg);
    transform: translateX(105%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    z-index: 120;
    border-radius: 16px 0 0 16px;
    overflow: hidden;
  }
  .m985-panel.open {
    transform: translateX(0);
  }
  .m985-panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 18px 14px;
    background: linear-gradient(135deg, var(--primary-soft), transparent);
    border-bottom: 1px solid var(--border);
  }
  .m985-panel-emoji {
    font-size: 38px;
  }
  .m985-panel-head h2 {
    margin: 0;
    font-size: 20px;
    color: var(--text);
  }
  .m985-panel-head p {
    margin: 3px 0 0;
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  .m985-close {
    margin-left: auto;
    border: 0;
    background: var(--surface-soft);
    color: var(--text-secondary);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .m985-close:hover {
    background: var(--primary-soft);
    color: var(--primary);
    transform: rotate(90deg);
  }
  .m985-panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px 24px;
  }
  .m985-sec {
    margin-bottom: 16px;
  }
  .m985-sec h4 {
    font-size: 13px;
    color: var(--primary);
    margin: 0 0 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .m985-sec p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text);
  }
  .m985-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .m985-chips span {
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .m985-mask {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.32);
    z-index: 110;
  }
  @media (max-width: 640px) {
    .m985-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .m985-chip {
      flex: 0 0 auto;
    }
    .m985-stat {
      display: none;
    }
    #m985Map {
      height: calc(100vh - 190px);
      min-height: 380px;
    }
    .m985-panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 78vh;
      border-radius: 18px 18px 0 0;
      transform: translateY(105%);
    }
    .m985-panel.open {
      transform: translateY(0);
    }
  }
  /* 趣味与 AI 机器人 */
  .m985-flip-banner {
    margin: -2px 0 14px;
    padding: 10px 12px;
    border-radius: 12px;
    background: linear-gradient(135deg, #fff6e0, #ffe9f3);
    border: 1px dashed #f2c66d;
    color: #8a5a00;
    font-size: 13px;
    line-height: 1.6;
  }
  .m985-easter {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .mbot-fab {
    position: fixed;
    right: 22px;
    bottom: calc(150px + env(safe-area-inset-bottom, 0px));
    z-index: 95;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: #fff;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(99, 102, 241, 0.4);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease;
  }
  .mbot-fab:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 28px rgba(99, 102, 241, 0.5);
  }
  .mbot-card {
    position: fixed;
    right: 18px;
    bottom: calc(212px + env(safe-area-inset-bottom, 0px));
    z-index: 96;
    width: min(340px, calc(100vw - 28px));
    max-height: 58vh;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 16px 44px rgba(30, 41, 59, 0.22);
    overflow: hidden;
    transform-origin: bottom right;
    animation: mbot-pop 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mbot-card[hidden] { display: none; }
  @keyframes mbot-pop {
    from { opacity: 0; transform: translateY(12px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  .mbot-head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 12px 14px;
    background: linear-gradient(135deg, #eef2ff, #faf5ff);
    border-bottom: 1px solid #e5e7f5;
  }
  .mbot-head b { font-size: 14px; color: #3730a3; }
  .mbot-head div div { font-size: 11.5px; color: #7c7f9e; }
  .mbot-close {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: #7c7f9e;
    font-size: 18px;
    cursor: pointer;
    line-height: 1;
  }
  .mbot-msgs {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #f8f9fe;
  }
  .mbot-msg {
    max-width: 88%;
    padding: 8px 11px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.65;
    white-space: pre-wrap;
    color: #1e293b;
  }
  .mbot-msg.mbot-bot { align-self: flex-start; background: #fff; border: 1px solid #e5e7f5; }
  .mbot-msg.mbot-me { align-self: flex-end; background: #6366f1; color: #fff; }
  .mbot-school {
    display: inline-block;
    margin: 4px 4px 0 0;
    border: 1px solid #c7d2fe;
    background: #eef2ff;
    color: #3730a3;
    font-size: 12px;
    padding: 3px 9px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .mbot-school:hover { background: #6366f1; color: #fff; transform: translateY(-1px); }
  .mbot-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 8px 12px 0;
    background: #f8f9fe;
  }
  .mbot-chip {
    border: 1px solid #dbe0f5;
    background: #fff;
    color: #4f5596;
    font-size: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .mbot-chip:hover { border-color: #6366f1; color: #6366f1; }
  .mbot-input-row {
    display: flex;
    gap: 8px;
    padding: 10px 12px 12px;
    background: #f8f9fe;
    border-top: 1px solid #eef0f8;
  }
  .mbot-input-row input {
    flex: 1;
    border: 1px solid #dbe0f5;
    border-radius: 999px;
    padding: 8px 13px;
    font-size: 13px;
    outline: none;
    background: #fff;
    color: #1e293b;
  }
  .mbot-input-row button {
    border: 0;
    background: #6366f1;
    color: #fff;
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 13px;
    cursor: pointer;
  }
</style>

