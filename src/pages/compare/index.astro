---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sticker from '../../components/Sticker.astro';

const schools = (await getCollection('universities')).map((u) => ({
  id: u.id,
  name: u.data.name,
  nameEn: u.data.nameEn ?? '',
  province: u.data.province,
  city: u.data.city,
  type: u.data.type,
  levels: u.data.levels,
  tags: u.data.tags,
  established: u.data.established ?? null,
  campuses: u.data.campuses,
  brief: u.data.brief,
  transfer: u.data.transferPolicy?.summary ?? '',
  secondary: u.data.secondarySelection?.summary ?? '',
  training: u.data.trainingPlan?.summary ?? '',
  dorm: u.data.dorm?.summary ?? '',
  classes: u.data.classes?.summary ?? '',
  videos: u.data.videos.length,
  materials: u.data.materials.length,
}));
---

<BaseLayout
  title="大学对比"
  description="最多选择 3 所 985 高校，并排对比概况、政策摘要、寝室上课与资料数量。"
  robots="noindex,follow"
>
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <a href="/universities/">大学库</a> › <span>大学对比</span>
    </nav>
    <div class="page-hero">
      <h1>大学对比</h1>
      <p>
        在<a href="/universities/">大学库</a>勾选 2-3 所心仪的学校，并排比一比 ⚖️——
        也可以直接在地址栏追加参数，如 <code>?u=peking-university,tsinghua-university</code>。
      </p>
      <button class="btn btn-ghost" id="copyCompareLink" type="button">🔗 复制对比链接</button>
      <button class="btn btn-ghost" id="copySummary" type="button" hidden>📋 复制差异摘要</button>
      <button class="btn btn-ghost" id="printCompare" type="button">🖨️ 打印 / 导出 PDF</button>
      <button class="btn btn-ghost" id="onlyDiff" type="button" hidden>👀 只看差异</button>
    </div>

    <div id="compareApp">
      <div class="card empty-state" id="compareEmpty">
        <Sticker emoji="⚖️" animate="wiggle" label="还没有对比" />
        <p id="compareEmptyText">还没选学校呢～去大学库勾选 2-3 所，并排比一比！</p>
        <a class="btn btn-primary" href="/universities/">去大学库勾选 →</a>
      </div>
      <div class="table-wrap" id="compareTableWrap" hidden>
        <p class="table-swipe-hint">← 左右滑动查看更多列 →</p>
        <table class="compare-table" id="compareTable"></table>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ schools }}>
  window.__CMP_SCHOOLS__ = schools;
</script>

<script>
import { scopedKey } from '../../lib/account';
  const schools = (window as unknown as { __CMP_SCHOOLS__?: typeof window.__CMP_SCHOOLS__ }).__CMP_SCHOOLS__ ?? [];
  const wrap = document.getElementById('compareTableWrap');
  const empty = document.getElementById('compareEmpty');
  const table = document.getElementById('compareTable');
  const copyBtn = document.getElementById('copyCompareLink');
  const summaryBtn = document.getElementById('copySummary');
  const printBtn = document.getElementById('printCompare');
  const onlyDiffBtn = document.getElementById('onlyDiff');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard
      ?.writeText(window.location.href)
      .then(() => {
        copyBtn.textContent = '已复制 ✓';
        setTimeout(() => (copyBtn.textContent = '复制对比链接'), 1600);
      })
      .catch(() => {});
  });
  printBtn?.addEventListener('click', () => window.print());

  const params = new URLSearchParams(window.location.search);
  let slugs = (params.get('u') ?? '')
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean)
    .slice(0, 3);
  if (slugs.length === 0) {
    try {
      slugs = JSON.parse(localStorage.getItem(scopedKey('compare-list')) || '[]').slice(0, 3);
      if (slugs.length > 0) {
        history.replaceState(null, '', `/compare/?u=${slugs.join(',')}`);
      }
    } catch {
      slugs = [];
    }
  }
  const picked = slugs
    .map((s) => schools.find((x) => x.id === s))
    .filter(Boolean);

  if (picked.length < 2) {
    empty.hidden = false;
    const text = document.getElementById('compareEmptyText');
    if (text) {
      if (picked.length === 1) {
        text.innerHTML = `已选择 1 所（${picked[0].name}），再去大学库勾选 1-2 所即可并排对比。`;
      } else {
        text.innerHTML = '还没有选择学校。前往大学库勾选 2-3 所后并排对比。';
      }
    }
  } else {
    empty.hidden = true;
    wrap.hidden = false;
    const caption = document.createElement('caption');
    caption.textContent = `${picked.map((s) => s.name).join('、')} 对比表`;
    table.appendChild(caption);
    const rows = [
      ['学校', (s) => s.name],
      ['英文名', (s) => s.nameEn],
      ['省份 / 城市', (s) => `${s.province} ${s.city}`],
      ['类型', (s) => `${s.type}类`],
      ['层次', (s) => s.levels.join(' / ')],
      ['标签', (s) => s.tags.join(' / ') || '—'],
      ['建校', (s) => (s.established ? `${s.established} 年` : '—')],
      ['校区', (s) => s.campuses.join(' / ') || '—'],
      ['学校概况', (s) => s.brief || '—'],
      ['转专业政策', (s) => s.transfer || '待补充'],
      ['二次选拔', (s) => s.secondary || '待补充'],
      ['培养计划', (s) => s.training || '待补充'],
      ['寝室情况', (s) => s.dorm || '待补充'],
      ['上课情况', (s) => s.classes || '待补充'],
      ['详情页', (s) => `<a href="/universities/${s.id}/">查看详情 →</a>`],
    ];
    const maxVideos = Math.max(...picked.map((s) => s.videos), 1);
    const maxMaterials = Math.max(...picked.map((s) => s.materials), 1);
    let summaryLines = [`【${picked.map((s) => s.name).join(' vs ')} 对比摘要】`];

    const head = document.createElement('thead');
    const hr = document.createElement('tr');
    const th = document.createElement('th');
    th.textContent = '对比项';
    th.scope = 'col';
    hr.appendChild(th);
    picked.forEach((s) => {
      const c = document.createElement('th');
      c.scope = 'col';
      const link = document.createElement('a');
      link.href = `/universities/${s.id}/`;
      link.textContent = s.name;
      c.appendChild(link);
      const favBtn = document.createElement('button');
      favBtn.type = 'button';
      favBtn.className = 'btn btn-ghost cmp-fav';
      let favs = [];
      try {
        favs = JSON.parse(localStorage.getItem(scopedKey('fav-universities')) || '[]');
      } catch {
        favs = [];
      }
      favBtn.textContent = favs.includes(s.id) ? '★' : '☆';
      favBtn.title = '收藏该学校';
      favBtn.addEventListener('click', () => {
        let list = [];
        try {
          list = JSON.parse(localStorage.getItem(scopedKey('fav-universities')) || '[]');
        } catch {
          list = [];
        }
        if (list.includes(s.id)) list = list.filter((x) => x !== s.id);
        else list.push(s.id);
        try {
          localStorage.setItem(scopedKey('fav-universities'), JSON.stringify(list));
        } catch {
          /* ignore */
        }
        favBtn.textContent = list.includes(s.id) ? '★' : '☆';
      });
      c.appendChild(favBtn);
      hr.appendChild(c);
    });
    head.appendChild(hr);
    table.appendChild(head);

    const body = document.createElement('tbody');
    rows.forEach(([label, fn]) => {
      const tr = document.createElement('tr');
      const tdLabel = document.createElement('td');
      tdLabel.className = 'row-label';
      tdLabel.textContent = label;
      tdLabel.scope = 'row';
      tr.appendChild(tdLabel);
      const values = picked.map((s) => String(fn(s) ?? '').trim());
      const allSame = values.every((v) => v === values[0]);
      tr.dataset.allSame = allSame ? '1' : '0';
      if (!allSame && label !== '学校' && label !== '英文名' && label !== '详情页') {
        summaryLines.push(
          `- ${label}：${picked.map((s, i) => `${s.name} ${values[i]}`).join('；')}`,
        );
      }
      picked.forEach((s) => {
        const td = document.createElement('td');
        td.innerHTML = fn(s);
        if (allSame) td.className = 'same';
        else if (values.indexOf(td.textContent?.trim() ?? '') !== 0) td.className = 'diff';
        tr.appendChild(td);
      });
      body.appendChild(tr);
    });

    const barRows = [
      ['视频数量', (s) => s.videos, maxVideos],
      ['资料数量', (s) => s.materials, maxMaterials],
    ];
    barRows.forEach(([label, fn, max]) => {
      const tr = document.createElement('tr');
      const tdLabel = document.createElement('td');
      tdLabel.className = 'row-label';
      tdLabel.textContent = label;
      tr.appendChild(tdLabel);
      picked.forEach((s) => {
        const td = document.createElement('td');
        const val = fn(s);
        const pct = Math.round((val / max) * 100);
        td.innerHTML = `<div class="bar-row"><div class="bar"><i style="width:${pct}%"></i></div><span>${val}</span></div>`;
        tr.appendChild(td);
      });
      body.appendChild(tr);
    });
    table.appendChild(body);
    if (onlyDiffBtn) {
      onlyDiffBtn.hidden = false;
      onlyDiffBtn.addEventListener('click', () => {
        const on = table.classList.toggle('only-diff');
        onlyDiffBtn.textContent = on ? '显示全部' : '只看差异';
      });
    }

    summaryLines.push(`- 视频：${picked.map((s) => `${s.name} ${s.videos}`).join('；')}`);
    summaryLines.push(`- 资料：${picked.map((s) => `${s.name} ${s.materials}`).join('；')}`);
    const summary = summaryLines.join('\n');
    if (summaryBtn) {
      summaryBtn.hidden = false;
      summaryBtn.addEventListener('click', () => {
        navigator.clipboard
          ?.writeText(summary)
          .then(() => {
            summaryBtn.textContent = '已复制 ✓';
            setTimeout(() => (summaryBtn.textContent = '复制差异摘要'), 1600);
          })
          .catch(() => {});
      });
    }

    const legend = document.createElement('p');
    legend.className = 'small muted compare-legend';
    legend.innerHTML = '图例：<span class="legend-diff">黄色</span> = 校际差异项，<span class="legend-same">灰色</span> = 各校一致项。';
    wrap.parentNode?.insertBefore(legend, wrap.nextSibling);
  }
</script>
