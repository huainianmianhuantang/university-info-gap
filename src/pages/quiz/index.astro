---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const schools = (await getCollection('universities')).map((u) => ({
  id: u.id,
  name: u.data.name,
  cover: u.data.cover,
  type: u.data.type,
  province: u.data.province,
  city: u.data.city,
  tags: u.data.tags,
  levels: u.data.levels,
}));
---

<BaseLayout
  title="选校测评"
  description="通过 12 道兴趣问卷，帮你找到适合的专业方向与 985 高校，并生成个性化建议。"
  robots="noindex,follow"
>
  <div class="container page">
    <div class="page-hero">
      <h1>选校测评</h1>
      <p>
        回答 12 道关于兴趣、性格与生活偏好的题目，约 2 分钟。
        完成后会为你推荐专业方向、匹配高校，并生成一份建议。结果只保存在你的浏览器本地。
      </p>
    </div>

    <div id="quizApp" class="quiz-app">
      <div class="card quiz-card" id="quizCard">
        <div class="quiz-progress" aria-hidden="true">
          <div class="quiz-progress-bar" id="progressBar"></div>
        </div>
        <button class="btn btn-ghost resume-note" id="resumeNote" type="button" hidden>
          已恢复上次未完成的问卷 · 点击重新开始
        </button>
        <div class="quiz-step-info" id="stepInfo" aria-live="polite">1 / 12</div>
        <h2 class="quiz-question" id="quizTitle"></h2>
        <p class="muted quiz-subtitle" id="quizSubtitle"></p>
        <div class="quiz-options" id="quizOptions"></div>
        <div class="quiz-nav">
          <button class="btn btn-ghost" id="prevBtn" type="button">上一步</button>
          <button class="btn btn-primary" id="nextBtn" type="button">下一步</button>
        </div>
      </div>

      <div class="card section-block" id="resultCard" hidden aria-live="polite">
        <div class="section-head">
          <h2>你的测评结果</h2>
          <div class="result-actions">
            <button class="btn btn-ghost" id="copyBtn" type="button">复制结果</button>
            <button class="btn btn-ghost" id="shareBtn" type="button">复制结果链接</button>
            <button class="btn btn-ghost" id="printResult" type="button">打印结果</button>
            <button class="btn btn-ghost" id="restartBtn" type="button">重新测评</button>
          </div>
        </div>

              <p class="small muted" id="loginTip" hidden>💡 登录后，测评结果会保存在你的账号下。</p>
<section class="result-section">
          <h3>兴趣画像</h3>
          <div class="chip-row" id="resultDims"></div>
        </section>

        <section class="result-section">
          <h3>匹配专业方向</h3>
          <div class="chip-row" id="resultMajors"></div>
        </section>

        <section class="result-section">
          <h3>推荐高校</h3>
          <p class="muted">
            点进学校详情页，可查看转专业政策、培养计划、宿舍实况与课堂/校园视频。
          </p>
          <div class="grid grid-universities" id="resultSchools"></div>
        </section>

        <section class="result-section">
          <h3>冲 / 稳 / 保 分档（可选）</h3>
          <p class="muted">
            输入你的预估全省位次（理科参考值），为推荐学校粗略分档；仅供参考，最终以官方数据为准。
          </p>
          <div class="rank-input">
            <input type="number" id="rankInput" min="1" max="99999" placeholder="如 5000" aria-label="预估全省位次" />
            <select id="rankType" aria-label="科类">
              <option value="physics">物理类（理科）</option>
              <option value="history">历史类（文科）</option>
            </select>
            <button class="btn" id="rankApply" type="button">分档</button>
          </div>
          <p class="small muted" id="rankWarn" hidden>
            ⚠️ 历史类（文科）位次与物理类口径不同，请先按本省一分一段表自行换算，再参考下方分档。
          </p>
          <div class="chip-row" id="rankLegend"></div>
        </section>

        <section class="result-section">
          <div class="result-section-head">
            <h3>AI 建议</h3>
            <button class="btn btn-ghost" id="regenBtn" type="button" hidden>换一批建议</button>
            <button class="btn btn-ghost" id="copyAdviceBtn" type="button">复制建议</button>
          </div>
          <div class="advice-box" id="resultAdvice"></div>
          <p class="small muted" id="adviceBadge">AI 建议生成中…</p>
        </section>
      </div>

      <section class="card section-block" id="historySection" hidden>
        <div class="section-head">
          <h2>历史测评</h2>
          <button class="btn btn-ghost" id="clearHistory" type="button">清空历史</button>
        </div>
        <ul class="point-list" id="historyList"></ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ schools }}>
  import { QUESTIONS, recommend, DIM_LABELS, tierOf } from '../../lib/recommender';
  import { getAdvice } from '../../lib/ai';
import { scopedKey } from '../../lib/account';


  const LS_ANSWERS = 'quiz-answers';
  const LS_RESULT = scopedKey('quiz-result');

  const state = {
    step: 0,
    answers: {},
    rank: null,
  };

  const quizCard = document.getElementById('quizCard');
  const resultCard = document.getElementById('resultCard');
  const titleEl = document.getElementById('quizTitle');
  const subtitleEl = document.getElementById('quizSubtitle');
  const optionsEl = document.getElementById('quizOptions');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const progressBar = document.getElementById('progressBar');
  const stepInfo = document.getElementById('stepInfo');
  const resumeNote = document.getElementById('resumeNote');
  const restartBtn = document.getElementById('restartBtn');
  const rankInput = document.getElementById('rankInput');
  const rankApply = document.getElementById('rankApply');
  const rankType = document.getElementById('rankType');
  const rankWarn = document.getElementById('rankWarn');
  const rankLegend = document.getElementById('rankLegend');
  const historySection = document.getElementById('historySection');
  const historyList = document.getElementById('historyList');
  const clearHistoryBtn = document.getElementById('clearHistory');
  let currentResult = null;
  const HISTORY_KEY = scopedKey('quiz-history');
  const loginTip = document.getElementById('loginTip');
  if (loginTip) {
    import('../../lib/account').then((m) => {
      loginTip.hidden = m.isLoggedIn();
    });
  }
  const copyBtn = document.getElementById('copyBtn');
  const shareBtn = document.getElementById('shareBtn');
  const printResultBtn = document.getElementById('printResult');
  const regenBtn = document.getElementById('regenBtn');
  const copyAdviceBtn = document.getElementById('copyAdviceBtn');

  async function fetchLLMAdvice(answers, result) {
    const resp = await fetch('/api/advice', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        answers,
        result: {
          dims: result.dims,
          majors: result.majors,
          schools: result.schools.map((s) => ({
            name: s.profile?.name ?? s.name,
            majors: s.majors,
            city: s.profile?.city ?? s.city,
          })),
        },
      }),
    });
    const data = await resp.json();
    if (!data || !data.text) return null;
    return {
      provider: 'llm',
      text: data.text,
      points: data.points ?? [data.text],
    };
  }

  function loadSaved() {
    try {
      const savedAnswers = JSON.parse(localStorage.getItem(LS_ANSWERS) || 'null');
      const savedResult = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
      if (savedAnswers && savedResult) {
        Object.assign(state.answers, savedAnswers);
        showResult(savedResult);
        if (savedResult.advice?.provider !== 'llm') {
          const result = savedResult.result;
          fetchLLMAdvice(state.answers, result)
            .then((advice) => {
              if (advice) {
                const upgraded = { result, advice, at: Date.now() };
                try {
                  localStorage.setItem(LS_RESULT, JSON.stringify(upgraded));
                } catch {
                  /* ignore */
                }
                showResult(upgraded);
              }
            })
            .catch(() => {});
        }
        return true;
      }
      if (savedAnswers) {
        Object.assign(state.answers, savedAnswers);
        const last = QUESTIONS.findIndex((q) => !(q.id in savedAnswers));
        state.step = last === -1 ? QUESTIONS.length - 1 : last;
      }
    } catch {
      /* ignore corrupted storage */
    }
    return false;
  }

  function renderQuestion() {
    const q = QUESTIONS[state.step];
    titleEl.textContent = q.title;
    subtitleEl.textContent = q.subtitle ?? '';
    subtitleEl.style.display = q.subtitle ? '' : 'none';
    stepInfo.textContent = `${state.step + 1} / ${QUESTIONS.length}`;
    progressBar.style.width = `${((state.step + 1) / QUESTIONS.length) * 100}%`;

    optionsEl.innerHTML = '';
    q.options.forEach((opt, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'quiz-option';
      btn.textContent = opt.label;
      if (state.answers[q.id] === idx) btn.classList.add('selected');
      btn.addEventListener('click', () => {
        state.answers[q.id] = idx;
        optionsEl.querySelectorAll('.quiz-option').forEach((b) =>
          b.classList.toggle('selected', b === btn),
        );
        saveAnswers();
      });
      optionsEl.appendChild(btn);
    });

    prevBtn.disabled = state.step === 0;
    nextBtn.textContent = state.step === QUESTIONS.length - 1 ? '查看结果' : '下一步';
    nextBtn.disabled = !(state.answers[q.id] !== undefined);
    quizCard.hidden = false;
    resultCard.hidden = true;
    if (resumeNote) {
      resumeNote.hidden = Object.keys(state.answers).length === 0;
    }
  }

  function saveAnswers() {
    try {
      localStorage.setItem(LS_ANSWERS, JSON.stringify(state.answers));
    } catch {
      /* storage full / unavailable */
    }
  }

  function readHistory() {
    try {
      return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function renderHistory() {
    const h = readHistory();
    if (!historySection || !historyList) return;
    historySection.hidden = h.length === 0;
    historyList.innerHTML = '';
    h.forEach((item, idx) => {
      const li = document.createElement('li');
      li.className = 'point-item';
      const dims = (item.result?.dims ?? [])
        .map((d) => DIM_LABELS[d.dim] ?? d.dim)
        .join('、');
      const schools = (item.result?.schools ?? [])
        .slice(0, 3)
        .map((s) => s.profile?.name ?? '')
        .filter(Boolean)
        .join('、');
      const when = new Date(item.at ?? Date.now()).toLocaleString('zh-CN');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-ghost';
      btn.textContent = '查看';
      btn.addEventListener('click', () => showResult(item));
      li.innerHTML = `<strong>${when}</strong><p>兴趣：${dims}${schools ? `｜推荐：${schools}` : ''}</p>`;
      li.appendChild(btn);
      historyList.appendChild(li);
    });
  }

  function saveHistory(saved) {
    try {
      const h = readHistory();
      h.unshift({ at: saved.at ?? Date.now(), result: saved.result, advice: saved.advice });
      localStorage.setItem(HISTORY_KEY, JSON.stringify(h.slice(0, 5)));
    } catch {
      /* ignore */
    }
    renderHistory();
  }

  async function compute() {
    const result = recommend(state.answers, schools);
    const ruleAdvice = getAdvice({ answers: state.answers, result, schools });
    let saved = { result, advice: ruleAdvice, at: Date.now() };
    try {
      localStorage.setItem(LS_RESULT, JSON.stringify(saved));
    } catch {
      /* ignore */
    }
    showResult(saved);

    try {
      const advice = await fetchLLMAdvice(state.answers, result);
      if (advice) {
        saved = { result, advice, at: Date.now() };
        try {
          localStorage.setItem(LS_RESULT, JSON.stringify(saved));
        } catch {
          /* ignore */
        }
        showResult(saved);
      } else {
        const badge = document.getElementById('adviceBadge');
        if (badge) badge.textContent = 'AI 建议（规则引擎生成）';
      }
    } catch {
      const badge = document.getElementById('adviceBadge');
      if (badge) badge.textContent = 'AI 建议（规则引擎生成）';
    }
    saveHistory(saved);
  }

  function showResult(saved) {
    const { result, advice } = saved;
    quizCard.hidden = true;
    resultCard.hidden = false;

    const dimsEl = document.getElementById('resultDims');
    dimsEl.innerHTML = '';
    if (result.dims.length > 0) {
      const max = result.dims[0].score || 1;
      const wrap = document.createElement('div');
      wrap.className = 'dim-bars';
      result.dims.forEach(({ dim, score }, i) => {
        const row = document.createElement('div');
        row.className = 'dim-bar';
        row.innerHTML = `<span>${DIM_LABELS[dim]}${i === 0 ? ' ★' : ''}</span><div class="bar"><i style="width:${Math.round((score / max) * 100)}%"></i></div><b>${score}</b>`;
        wrap.appendChild(row);
      });
      dimsEl.appendChild(wrap);
    }

    const majorsEl = document.getElementById('resultMajors');
    majorsEl.innerHTML = '';
    result.majors.forEach((m) => {
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.textContent = m;
      majorsEl.appendChild(chip);
    });

    currentResult = result;
    renderSchools(result);

    const adviceEl = document.getElementById('resultAdvice');
    adviceEl.innerHTML = '';
    advice.points.forEach((p) => {
      const item = document.createElement('p');
      item.className = 'advice-point';
      item.textContent = p;
      adviceEl.appendChild(item);
    });
    const badge = document.getElementById('adviceBadge');
    if (badge) {
      badge.textContent =
        advice.provider === 'llm'
          ? 'AI 建议（DeepSeek 大模型生成）'
          : 'AI 建议（规则引擎生成）';
    }
    if (regenBtn) regenBtn.hidden = advice.provider !== 'llm';

    try {
      localStorage.setItem(LS_RESULT, JSON.stringify(saved));
    } catch {
      /* ignore */
    }
    resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderSchools(result) {
    const schoolsEl = document.getElementById('resultSchools');
    schoolsEl.innerHTML = '';
    if (!result || result.schools.length === 0) {
      const p = document.createElement('p');
      p.className = 'muted';
      p.textContent = '暂无高匹配学校，建议前往大学库按省份与类型浏览。';
      schoolsEl.appendChild(p);
      return;
    }
    const maxScore = result.schools[0]?.score ?? 1;
    result.schools.forEach((s) => {
      const wrap = document.createElement('div');
      wrap.className = 'u-item';
      const actions = document.createElement('div');
      actions.className = 'result-actions result-card-actions';
      const favBtn = document.createElement('button');
      favBtn.type = 'button';
      favBtn.className = 'btn btn-ghost';
      favBtn.textContent = '☆ 收藏';
      favBtn.addEventListener('click', (e) => {
        e.preventDefault();
        try {
          const favs = new Set(JSON.parse(localStorage.getItem(scopedKey('fav-universities')) || '[]'));
          if (favs.has(s.profile.id)) favs.delete(s.profile.id);
          else favs.add(s.profile.id);
          localStorage.setItem(scopedKey('fav-universities'), JSON.stringify([...favs]));
          favBtn.textContent = favs.has(s.profile.id) ? '★ 已收藏' : '☆ 收藏';
        } catch {
          /* ignore */
        }
      });
      const cmpBtn = document.createElement('button');
      cmpBtn.type = 'button';
      cmpBtn.className = 'btn btn-ghost';
      cmpBtn.textContent = '＋ 对比';
      cmpBtn.addEventListener('click', (e) => {
        e.preventDefault();
        try {
          const list = JSON.parse(localStorage.getItem(scopedKey('compare-list')) || '[]');
          if (list.includes(s.profile.id)) {
            const next = list.filter((x) => x !== s.profile.id);
            localStorage.setItem(scopedKey('compare-list'), JSON.stringify(next));
            cmpBtn.textContent = '＋ 对比';
          } else {
            const next = list.length >= 3 ? [...list.slice(1), s.profile.id] : [...list, s.profile.id];
            localStorage.setItem(scopedKey('compare-list'), JSON.stringify(next));
            cmpBtn.textContent = `已选 ${next.length}/3`;
          }
        } catch {
          /* ignore */
        }
      });
      actions.appendChild(favBtn);
      actions.appendChild(cmpBtn);
      wrap.appendChild(actions);
      const a = document.createElement('a');
      a.className = 'card university-card';
      a.href = `/universities/${s.profile.id}/`;
      const img = document.createElement('img');
      img.className = 'university-cover';
      img.src = s.profile.cover;
      img.alt = `${s.profile.name} 校徽`;
      img.loading = 'lazy';
      img.decoding = 'async';
      a.appendChild(img);
      const body = document.createElement('div');
      body.className = 'university-body';
      const pct = Math.round((s.score / maxScore) * 100);
      const tier = state.rank ? tierOf(state.rank, s.profile.id) : null;
      const tierHtml = tier
        ? `<span class="chip tier-badge tier-${tier}">${tier}</span>`
        : '';
      body.innerHTML = `
        <h3>${s.profile.name}</h3>
        <p class="small muted">${s.profile.type} · ${s.profile.province} ${s.profile.city}</p>
        <p class="small">匹配方向：${s.majors.slice(0, 4).join(' / ')}</p>
        <div class="chip-row"><span class="chip result-chip">匹配度 ${pct}%</span>${tierHtml}</div>
      `;
      a.appendChild(body);
      wrap.appendChild(a);
      schoolsEl.appendChild(wrap);
    });
  }

  function renderLegend() {
    if (!rankLegend) return;
    rankLegend.innerHTML = '';
    if (!state.rank) return;
    [
      ['冲', '位次略高于该校往年门槛，可尝试'],
      ['稳', '位次基本达到往年门槛'],
      ['保', '位次有明显余量，比较稳妥'],
    ].forEach(([label, desc]) => {
      const chip = document.createElement('span');
      chip.className = `chip tier-badge tier-${label}`;
      chip.textContent = `${label}：${desc}`;
      rankLegend.appendChild(chip);
    });
  }

  function restart() {
    state.step = 0;
    state.answers = {};
    state.rank = null;
    if (rankInput) rankInput.value = '';
    if (rankWarn) rankWarn.hidden = true;
    try {
      localStorage.removeItem(LS_ANSWERS);
      localStorage.removeItem(LS_RESULT);
    } catch {
      /* ignore */
    }
    renderQuestion();
  }

  prevBtn.addEventListener('click', () => {
    if (state.step > 0) {
      state.step--;
      renderQuestion();
    }
  });

  nextBtn.addEventListener('click', () => {
    const q = QUESTIONS[state.step];
    if (state.answers[q.id] === undefined) return;
    if (state.step < QUESTIONS.length - 1) {
      state.step++;
      renderQuestion();
    } else {
      compute();
    }
  });

  restartBtn.addEventListener('click', restart);
  resumeNote?.addEventListener('click', () => {
    if (!window.confirm('确定重新开始吗？已作答的内容会清空。')) return;
    state.step = 0;
    state.answers = {};
    try {
      localStorage.removeItem(LS_ANSWERS);
    } catch {
      /* ignore */
    }
    renderQuestion();
  });
  clearHistoryBtn?.addEventListener('click', () => {
    try {
      localStorage.removeItem(HISTORY_KEY);
    } catch {
      /* ignore */
    }
    renderHistory();
  });
  rankApply?.addEventListener('click', () => {
    const v = Number(rankInput?.value ?? '');
    state.rank = Number.isFinite(v) && v > 0 ? v : null;
    renderSchools(currentResult);
    renderLegend();
    if (rankWarn) rankWarn.hidden = rankType?.value !== 'history';
  });
  rankType?.addEventListener('change', () => {
    if (rankWarn) rankWarn.hidden = rankType.value !== 'history';
  });
  rankInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') rankApply?.click();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key < '1' || e.key > '9') return;
    const tag = (e.target as HTMLElement)?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    const quizCard = document.getElementById('quizCard');
    const resultCard = document.getElementById('resultCard');
    if (quizCard?.hidden || !resultCard?.hidden) return;
    const opts = Array.from(document.querySelectorAll('#quizOptions .quiz-option'));
    const idx = Number(e.key) - 1;
    if (idx < opts.length) (opts[idx] as HTMLButtonElement).click();
  });
  copyBtn.addEventListener('click', () => {
    const saved = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
    if (!saved) return;
    const { result, advice } = saved;
    const lines = [
      '【象牙塔透视镜·选校测评结果】',
      `兴趣画像：${result.dims.map((d) => DIM_LABELS[d.dim]).join('、')}`,
      `匹配专业：${result.majors.slice(0, 8).join('、')}`,
      `推荐高校：${result.schools.slice(0, 5).map((s) => s.profile.name).join('、')}`,
      '',
      'AI 建议：',
      advice?.text ?? '',
      '',
      '来自：象牙塔透视镜（仅供参考）',
    ].join('\n');
    navigator.clipboard
      ?.writeText(lines)
      .then(() => {
        copyBtn.textContent = '已复制 ✓';
        window.showToast?.('结果已复制到剪贴板');
        setTimeout(() => (copyBtn.textContent = '复制结果'), 1600);
      })
      .catch(() => {});
  });

  copyAdviceBtn?.addEventListener('click', () => {
    const saved = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
    const text = saved?.advice?.text || '';
    if (!text) {
      window.showToast?.('暂无建议内容');
      return;
    }
    navigator.clipboard
      ?.writeText(text)
      .then(() => window.showToast?.('建议已复制'))
      .catch(() => {});
  });

  shareBtn?.addEventListener('click', () => {
    try {
      const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(state.answers))));
      const url = `${window.location.origin}/quiz/?r=${encoded}`;
      navigator.clipboard
        ?.writeText(url)
        .then(() => {
          shareBtn.textContent = '已复制 ✓';
          window.showToast?.('分享内容已复制');
          setTimeout(() => (shareBtn.textContent = '复制结果链接'), 1600);
        })
        .catch(() => {});
    } catch {
      /* ignore */
    }
  });
  printResultBtn?.addEventListener('click', () => window.print());

  regenBtn?.addEventListener('click', async () => {
    const saved = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
    if (!saved) return;
    regenBtn.disabled = true;
    regenBtn.textContent = '生成中…';
    try {
      const advice = await fetchLLMAdvice(state.answers, saved.result);
      if (advice) {
        const updated = { ...saved, advice, at: Date.now() };
        try {
          localStorage.setItem(LS_RESULT, JSON.stringify(updated));
        } catch {
          /* ignore */
        }
        showResult(updated);
      }
    } catch {
      /* ignore */
    }
    regenBtn.disabled = false;
    regenBtn.textContent = '换一批建议';
  });

  const params = new URLSearchParams(window.location.search);
  const shared = params.get('r');
  if (shared) {
    try {
      const ans = JSON.parse(decodeURIComponent(escape(atob(shared))));
      if (ans && QUESTIONS.every((q) => ans[q.id] !== undefined)) {
        Object.assign(state.answers, ans);
        saveAnswers();
        compute();
        history.replaceState(null, '', '/quiz/');
      } else if (!loadSaved()) {
        renderQuestion();
      }
    } catch {
      if (!loadSaved()) renderQuestion();
    }
  } else if (!loadSaved()) {
    renderQuestion();
  }
  renderHistory();
</script>
