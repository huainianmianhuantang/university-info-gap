---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sticker from '../../components/Sticker.astro';

const schools = (await getCollection('universities')).map((u) => ({
  id: u.id,
  name: u.data.name,
  cover: u.data.cover,
  type: u.data.type,
  province: u.data.province,
  city: u.data.city,
  tags: u.data.tags,
  levels: u.data.levels,
  materialCategories: [...new Set(u.data.materials.map((m) => m.category))],
}));
---

<BaseLayout
  title="选校测评"
  description="四套问卷（学生/家长 × 轻量/全面）可选，从学生与家长双视角为你各推荐 3 所 985 高校，并生成个性化建议。"
  robots="noindex,follow"
>
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <span>选校测评</span>
    </nav>
    <div class="page-hero">
      <h1>选校测评</h1>
      <p>
        先选择一套问卷，回答完会自动从「学生视角」和「家长视角」各推荐 3 所 985 高校，
        并生成一份个性化建议。结果只保存在你的浏览器本地。
      </p>
    </div>

    <div id="quizApp" class="quiz-app">
      <div class="card section-block" id="typeCard">
        <h2>先选一套问卷</h2>
        <p class="muted">学生问卷偏重兴趣与校园生活，家长问卷偏重就业、深造与成本；轻量与全面按时间自由选。</p>
        <div class="quiz-type-list" id="quizTypes"></div>
      </div>

      <div class="card quiz-card" id="quizCard" hidden>
        <div class="quiz-progress" aria-hidden="true">
          <div class="quiz-progress-bar" id="progressBar"></div>
        </div>
        <div class="quiz-body">
          <button class="btn btn-ghost resume-note" id="resumeNote" type="button" hidden>
            已恢复上次未完成的问卷 · 点击重新开始
          </button>
          <div class="quiz-step-info" id="stepInfo" aria-live="polite">1 / 12</div>
          <h2 class="quiz-question" id="quizTitle"></h2>
          <p class="muted quiz-subtitle" id="quizSubtitle"></p>
          <div class="quiz-options" id="quizOptions"></div>
          <p class="quiz-kbd-hint" aria-hidden="true">⌨️ 按数字键 1-9 可快速选择</p>
          <div class="quiz-nav">
            <button class="btn btn-ghost" id="prevBtn" type="button">上一步</button>
            <button class="btn btn-primary" id="nextBtn" type="button">下一步</button>
          </div>
        </div>
      </div>

      <div class="card section-block" id="resultCard" hidden aria-live="polite">
        <div class="section-head">
          <h2 style="display:flex;align-items:center;gap:10px;">
            <Sticker emoji="🎉" animate="pop" size={36} label="完成" />
            你的测评结果
          </h2>
          <div class="result-actions">
            <button class="btn btn-ghost" id="copyBtn" type="button">📋 复制结果</button>
            <button class="btn btn-ghost" id="shareBtn" type="button">🔗 复制结果链接</button>
            <button class="btn btn-ghost" id="printResult" type="button">🖨️ 打印结果</button>
            <button class="btn btn-ghost" id="restartBtn" type="button">🔄 重新测评</button>
          </div>
        </div>

        <p class="small muted" id="loginTip" hidden>💡 登录后，测评结果会保存在你的账号下。</p>
        <p class="small muted">
          🎯 匹配基于公开资料与学校画像推断，仅供信息参考，不构成志愿填报建议。
        </p>

        <section class="result-section">
          <h3>兴趣画像</h3>
          <div class="chip-row" id="resultDims"></div>
        </section>

        <section class="result-section">
          <h3>匹配专业方向</h3>
          <div class="chip-row" id="resultMajors"></div>
        </section>

        <section class="result-section" id="studentSection">
          <div class="result-section-head">
            <h3>🎒 学生视角 · 推荐 3 所</h3>
            <span class="small muted">更贴合兴趣、学习方式与生活偏好</span>
          </div>
          <p class="small muted">点进学校详情页，可查看转专业政策、培养计划、宿舍实况与课堂/校园视频。</p>
          <div class="grid grid-universities" id="studentSchools"></div>
          <details class="more-matches" id="studentMore" hidden>
            <summary>更多匹配（<span id="studentMoreCount">0</span> 所）</summary>
            <div class="grid grid-universities" id="studentMoreSchools"></div>
          </details>
        </section>

        <section class="result-section" id="parentSection">
          <div class="result-section-head">
            <h3>🏛️ 家长视角 · 推荐 3 所</h3>
            <span class="small muted">更看重就业、深造、成本与城市</span>
          </div>
          <p class="small muted">结合学校资料齐全度与公开画像推断，仅供信息参考。</p>
          <div class="grid grid-universities" id="parentSchools"></div>
          <details class="more-matches" id="parentMore" hidden>
            <summary>更多匹配（<span id="parentMoreCount">0</span> 所）</summary>
            <div class="grid grid-universities" id="parentMoreSchools"></div>
          </details>
        </section>

        <section class="result-section">
          <div class="result-section-head">
            <h3>📝 选校建议</h3>
            <button class="btn btn-ghost" id="regenBtn" type="button" hidden>换一批建议</button>
            <button class="btn btn-ghost" id="copyAdviceBtn" type="button">复制建议</button>
          </div>
          <div class="advice-box" id="resultAdvice"></div>
          <p class="small muted" id="adviceBadge">选校建议生成中…</p>
        </section>
      </div>

      <section class="card section-block" id="historySection" hidden>
        <div class="section-head">
          <h2>历史测评</h2>
          <button class="btn btn-ghost" id="clearHistory" type="button">清空历史</button>
        </div>
        <ul class="point-list" id="historyList"></ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ schools }}>
  window.__QUIZ_SCHOOLS__ = schools;
</script>

<script>
  import { QUIZ_TYPES, questionsOf, recommend, DIM_LABELS } from '../../lib/recommender';
  import { getAdvice } from '../../lib/ai';
  import { scopedKey } from '../../lib/account';

  const schools = (window as unknown as { __QUIZ_SCHOOLS__?: typeof window.__QUIZ_SCHOOLS__ }).__QUIZ_SCHOOLS__ ?? [];

  function esc(s: string): string {
    return String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
    );
  }

  const LS_ANSWERS = 'quiz-answers';
  const LS_RESULT = scopedKey('quiz-result');
  const LS_TYPE = 'quiz-type';

  const state = {
    typeId: null as string | null,
    step: 0,
    answers: {} as Record<string, number>,
  };

  const typeCard = document.getElementById('typeCard');
  const quizCard = document.getElementById('quizCard');
  const resultCard = document.getElementById('resultCard');
  const titleEl = document.getElementById('quizTitle');
  const subtitleEl = document.getElementById('quizSubtitle');
  const optionsEl = document.getElementById('quizOptions');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const progressBar = document.getElementById('progressBar');
  const stepInfo = document.getElementById('stepInfo');
  const resumeNote = document.getElementById('resumeNote');
  const restartBtn = document.getElementById('restartBtn');
  const historySection = document.getElementById('historySection');
  const historyList = document.getElementById('historyList');
  const clearHistoryBtn = document.getElementById('clearHistory');
  const loginTip = document.getElementById('loginTip');
  const copyBtn = document.getElementById('copyBtn');
  const shareBtn = document.getElementById('shareBtn');
  const printResultBtn = document.getElementById('printResult');
  const regenBtn = document.getElementById('regenBtn');
  const copyAdviceBtn = document.getElementById('copyAdviceBtn');
  let currentResult: any = null;
  const HISTORY_KEY = scopedKey('quiz-history');

  if (loginTip) {
    import('../../lib/account').then((m) => {
      loginTip.hidden = m.isLoggedIn();
    });
  }

  function questions() {
    return state.typeId ? questionsOf(state.typeId as any) : [];
  }

  function renderTypeSelect() {
    if (!typeCard || !quizCard) return;
    const grid = document.getElementById('quizTypes');
    if (!grid) return;
    grid.innerHTML = '';
    QUIZ_TYPES.forEach((t) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'quiz-type-row';
      btn.innerHTML = `
        <span class="quiz-type-icon">${t.icon}</span>
        <span class="quiz-type-text">
          <b>${esc(t.label)}</b>
          <small>${esc(t.desc)}</small>
        </span>
        <span class="quiz-type-arrow" aria-hidden="true">→</span>
      `;
      btn.addEventListener('click', () => {
        state.typeId = t.id;
        state.step = 0;
        state.answers = {};
        try {
          localStorage.setItem(LS_TYPE, state.typeId);
          localStorage.removeItem(LS_ANSWERS);
        } catch {
          /* ignore */
        }
        typeCard.hidden = true;
        quizCard.hidden = false;
        renderQuestion();
      });
      grid.appendChild(btn);
    });
  }

  async function fetchLLMAdvice(answers: Record<string, number>, result: any) {
    const resp = await fetch('/api/advice', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        answers,
        result: {
          dims: result.dims,
          majors: result.majors,
          student: { top3: result.student?.top3 ?? [] },
          parent: { top3: result.parent?.top3 ?? [] },
        },
      }),
    });
    const data = await resp.json();
    if (!data || !data.text) return null;
    return {
      provider: 'llm',
      text: data.text,
      points: data.points ?? [data.text],
    };
  }

  /** 兼容旧版 localStorage 结果（旧结构只有 schools 列表） */
  function normalizeResult(result: any): any {
    if (!result || (result.student && result.parent)) return result;
    if (Array.isArray(result.schools)) {
      const split = (list: any[]) => ({ top3: list.slice(0, 3), more: list.slice(3) });
      return {
        ...result,
        student: split(result.schools),
        parent: split(result.schools),
        order: ['student', 'parent'],
      };
    }
    return result;
  }

  function loadSaved(): boolean {
    try {
      const savedType = localStorage.getItem(LS_TYPE);
      const savedAnswers = JSON.parse(localStorage.getItem(LS_ANSWERS) || 'null');
      const savedResult = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
      if (savedType && QUIZ_TYPES.some((t) => t.id === savedType)) state.typeId = savedType;
      if (savedAnswers && savedResult) {
        Object.assign(state.answers, savedAnswers);
        const normalized = normalizeResult(savedResult.result);
        showResult({ ...savedResult, result: normalized });
        if (savedResult.advice?.provider !== 'llm') {
          fetchLLMAdvice(state.answers, normalized)
            .then((advice) => {
              if (advice) {
                const upgraded = { result: normalized, advice, at: Date.now() };
                try {
                  localStorage.setItem(LS_RESULT, JSON.stringify(upgraded));
                } catch {
                  /* ignore */
                }
                showResult(upgraded);
              }
            })
            .catch(() => {});
        }
        return true;
      }
      if (savedAnswers && state.typeId) {
        Object.assign(state.answers, savedAnswers);
        const qs = questions();
        const last = qs.findIndex((q) => !(q.id in savedAnswers));
        state.step = last === -1 ? qs.length - 1 : last;
      }
    } catch {
      /* ignore corrupted storage */
    }
    return false;
  }

  function renderQuestion() {
    const qs = questions();
    if (!state.typeId || qs.length === 0) {
      typeCard.hidden = false;
      quizCard.hidden = true;
      return;
    }
    const q = qs[state.step];
    titleEl.textContent = q.title;
    subtitleEl.textContent = q.subtitle ?? '';
    subtitleEl.style.display = q.subtitle ? '' : 'none';
    const pct = Math.round(((state.step + 1) / qs.length) * 100);
    stepInfo.textContent = `${state.step + 1} / ${qs.length} · ${pct}%`;
    progressBar.style.width = `${pct}%`;

    optionsEl.innerHTML = '';
    const KEYS = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I'];
    q.options.forEach((opt, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'quiz-option';
      btn.setAttribute('aria-pressed', 'false');
      const key = document.createElement('span');
      key.className = 'quiz-opt-key';
      key.textContent = KEYS[idx] ?? '';
      const label = document.createElement('span');
      label.className = 'quiz-opt-label';
      label.textContent = opt.label;
      const arrow = document.createElement('span');
      arrow.className = 'quiz-opt-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = state.answers[q.id] === idx ? '✓' : '→';
      btn.appendChild(key);
      btn.appendChild(label);
      btn.appendChild(arrow);
      if (state.answers[q.id] === idx) {
        btn.classList.add('selected');
        btn.setAttribute('aria-pressed', 'true');
      }
      btn.addEventListener('click', () => {
        state.answers[q.id] = idx;
        optionsEl.querySelectorAll('.quiz-option').forEach((b) => {
          const active = b === btn;
          b.classList.toggle('selected', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
          const arr = b.querySelector('.quiz-opt-arrow');
          if (arr) arr.textContent = active ? '✓' : '→';
        });
        nextBtn.disabled = false;
        saveAnswers();
      });
      optionsEl.appendChild(btn);
    });

    prevBtn.disabled = state.step === 0;
    nextBtn.textContent = state.step === qs.length - 1 ? '查看结果' : '下一步';
    nextBtn.disabled = state.answers[q.id] === undefined;
    quizCard.hidden = false;
    resultCard.hidden = true;
    if (resumeNote) resumeNote.hidden = Object.keys(state.answers).length === 0;
  }

  function saveAnswers() {
    try {
      localStorage.setItem(LS_ANSWERS, JSON.stringify(state.answers));
    } catch {
      /* storage full / unavailable */
    }
  }

  function readHistory() {
    try {
      return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function resultSchoolNames(result: any): string[] {
    const names: string[] = [];
    for (const key of ['student', 'parent']) {
      for (const s of result?.[key]?.top3 ?? []) {
        if (s?.profile?.name) names.push(s.profile.name);
      }
    }
    if (names.length === 0) {
      for (const s of result?.schools ?? []) {
        if (s?.profile?.name) names.push(s.profile.name);
      }
    }
    return [...new Set(names)];
  }

  function renderHistory() {
    const h = readHistory();
    if (!historySection || !historyList) return;
    historySection.hidden = h.length === 0;
    historyList.innerHTML = '';
    h.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'point-item';
      const dims = (item.result?.dims ?? [])
        .map((d: any) => DIM_LABELS[d.dim] ?? d.dim)
        .join('、');
      const schools = resultSchoolNames(item.result).slice(0, 4).join('、');
      const when = new Date(item.at ?? Date.now()).toLocaleString('zh-CN');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-ghost';
      btn.textContent = '查看';
      btn.addEventListener('click', () => showResult(item));
      li.innerHTML = `<strong>${esc(when)}</strong><p>兴趣：${esc(dims)}${schools ? `｜推荐：${esc(schools)}` : ''}</p>`;
      li.appendChild(btn);
      historyList.appendChild(li);
    });
  }

  function saveHistory(saved: any) {
    try {
      const h = readHistory();
      h.unshift({ at: saved.at ?? Date.now(), result: saved.result, advice: saved.advice });
      localStorage.setItem(HISTORY_KEY, JSON.stringify(h.slice(0, 5)));
    } catch {
      /* ignore */
    }
    renderHistory();
  }

  async function compute() {
    const result = recommend(state.answers, schools as any, state.typeId ?? undefined);
    const ruleAdvice = getAdvice({ answers: state.answers, result: result as any, schools: schools as any });
    let saved = { result, advice: ruleAdvice, at: Date.now() };
    try {
      localStorage.setItem(LS_RESULT, JSON.stringify(saved));
    } catch {
      /* ignore */
    }
    showResult(saved);

    try {
      const advice = await fetchLLMAdvice(state.answers, result);
      if (advice) {
        saved = { result, advice, at: Date.now() };
        try {
          localStorage.setItem(LS_RESULT, JSON.stringify(saved));
        } catch {
          /* ignore */
        }
        showResult(saved);
      } else {
        const badge = document.getElementById('adviceBadge');
        if (badge) badge.textContent = '选校建议（根据你的作答生成）';
      }
    } catch {
      const badge = document.getElementById('adviceBadge');
      if (badge) badge.textContent = '选校建议（根据你的作答生成）';
    }
    saveHistory(saved);
  }

  function showResult(saved: any) {
    const { result: raw, advice } = saved;
    const result = normalizeResult(raw);
    quizCard.hidden = true;
    typeCard.hidden = true;
    resultCard.hidden = false;

    const dimsEl = document.getElementById('resultDims');
    dimsEl.innerHTML = '';
    if (result.dims.length > 0) {
      const max = result.dims[0].score || 1;
      const wrap = document.createElement('div');
      wrap.className = 'dim-bars';
      result.dims.forEach(({ dim, score }: any, i: number) => {
        const row = document.createElement('div');
        row.className = 'dim-bar';
        row.innerHTML = `<span>${DIM_LABELS[dim]}${i === 0 ? ' ★' : ''}</span><div class="bar"><i style="width:${Math.round((score / max) * 100)}%"></i></div><b>${score}</b>`;
        wrap.appendChild(row);
      });
      dimsEl.appendChild(wrap);
    }

    const majorsEl = document.getElementById('resultMajors');
    majorsEl.innerHTML = '';
    result.majors.forEach((m: string) => {
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.textContent = m;
      majorsEl.appendChild(chip);
    });

    currentResult = result;
    renderPerspectives(result);

    const adviceEl = document.getElementById('resultAdvice');
    adviceEl.innerHTML = '';
    (advice?.points ?? []).forEach((p: string) => {
      const item = document.createElement('p');
      item.className = 'advice-point';
      item.textContent = p;
      adviceEl.appendChild(item);
    });
    const badge = document.getElementById('adviceBadge');
    if (badge) {
      badge.textContent =
        advice?.provider === 'llm'
          ? '选校建议（结合你的作答生成）'
          : '选校建议（根据你的作答生成）';
    }
    if (regenBtn) regenBtn.hidden = advice?.provider !== 'llm';

    try {
      localStorage.setItem(LS_RESULT, JSON.stringify(saved));
    } catch {
      /* ignore */
    }
    resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function schoolCard(s: any, maxScore: number): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'u-item';
    const actions = document.createElement('div');
    actions.className = 'result-actions result-card-actions';
    const favBtn = document.createElement('button');
    favBtn.type = 'button';
    favBtn.className = 'btn btn-ghost';
    favBtn.textContent = '☆ 收藏';
    favBtn.addEventListener('click', (e) => {
      e.preventDefault();
      try {
        const favs = new Set(JSON.parse(localStorage.getItem(scopedKey('fav-universities')) || '[]'));
        if (favs.has(s.profile.id)) favs.delete(s.profile.id);
        else favs.add(s.profile.id);
        localStorage.setItem(scopedKey('fav-universities'), JSON.stringify([...favs]));
        favBtn.textContent = favs.has(s.profile.id) ? '★ 已收藏' : '☆ 收藏';
      } catch {
        /* ignore */
      }
    });
    const cmpBtn = document.createElement('button');
    cmpBtn.type = 'button';
    cmpBtn.className = 'btn btn-ghost';
    cmpBtn.textContent = '＋ 对比';
    cmpBtn.addEventListener('click', (e) => {
      e.preventDefault();
      try {
        const list = JSON.parse(localStorage.getItem(scopedKey('compare-list')) || '[]');
        if (list.includes(s.profile.id)) {
          const next = list.filter((x: string) => x !== s.profile.id);
          localStorage.setItem(scopedKey('compare-list'), JSON.stringify(next));
          cmpBtn.textContent = '＋ 对比';
        } else {
          const next = list.length >= 3 ? [...list.slice(1), s.profile.id] : [...list, s.profile.id];
          localStorage.setItem(scopedKey('compare-list'), JSON.stringify(next));
          cmpBtn.textContent = `已选 ${next.length}/3`;
        }
      } catch {
        /* ignore */
      }
    });
    actions.appendChild(favBtn);
    actions.appendChild(cmpBtn);
    wrap.appendChild(actions);
    const a = document.createElement('a');
    a.className = 'card university-card';
    a.href = `/universities/${s.profile.id}/`;
    const img = document.createElement('img');
    img.className = 'university-cover';
    img.src = s.profile.cover;
    img.alt = `${s.profile.name} 校徽`;
    img.loading = 'lazy';
    img.decoding = 'async';
    a.appendChild(img);
    const body = document.createElement('div');
    body.className = 'university-body';
    const pct = Math.round((s.score / maxScore) * 100);
    body.innerHTML = `
      <h3>${esc(s.profile.name)}</h3>
      <p class="small muted">${esc(s.profile.type)} · ${esc(s.profile.province)} ${esc(s.profile.city)}</p>
      <p class="small">匹配方向：${s.majors.slice(0, 4).map(esc).join(' / ')}</p>
      <div class="chip-row"><span class="chip result-chip">匹配度 ${pct}%</span></div>
    `;
    a.appendChild(body);
    wrap.appendChild(a);
    return wrap;
  }

  function renderPerspectives(result: any) {
    const defs: Record<string, { listId: string; moreId: string; moreCountId: string; moreListId: string; sectionId: string }> = {
      student: {
        sectionId: 'studentSection',
        listId: 'studentSchools',
        moreId: 'studentMore',
        moreCountId: 'studentMoreCount',
        moreListId: 'studentMoreSchools',
      },
      parent: {
        sectionId: 'parentSection',
        listId: 'parentSchools',
        moreId: 'parentMore',
        moreCountId: 'parentMoreCount',
        moreListId: 'parentMoreSchools',
      },
    };
    const order = result.order ?? ['student', 'parent'];
    const stuSection = document.getElementById('studentSection');
    const parSection = document.getElementById('parentSection');
    if (stuSection && parSection) {
      const parentFirst = order[0] === 'parent';
      const isParentBefore = Boolean(stuSection.compareDocumentPosition(parSection) & Node.DOCUMENT_POSITION_FOLLOWING);
      if (parentFirst && isParentBefore) {
        stuSection.parentNode?.insertBefore(parSection, stuSection);
      } else if (!parentFirst && !isParentBefore) {
        parSection.parentNode?.insertBefore(stuSection, parSection);
      }
    }
    for (const key of order) {
      const d = defs[key];
      if (!d) continue;
      const section = document.getElementById(d.sectionId);
      const listEl = document.getElementById(d.listId);
      const moreEl = document.getElementById(d.moreId);
      const moreCount = document.getElementById(d.moreCountId);
      const moreList = document.getElementById(d.moreListId);
      const ranked = result[key] ?? { top3: [], more: [] };
      const all = [...(ranked.top3 ?? []), ...(ranked.more ?? [])];
      if (section) section.hidden = all.length === 0;
      if (!listEl || !moreEl || !moreList) continue;
      listEl.innerHTML = '';
      moreList.innerHTML = '';
      const maxScore = ranked.top3?.[0]?.score ?? ranked.more?.[0]?.score ?? 1;
      (ranked.top3 ?? []).forEach((s: any) => listEl.appendChild(schoolCard(s, maxScore)));
      if ((ranked.more ?? []).length > 0) {
        moreEl.hidden = false;
        if (moreCount) moreCount.textContent = ranked.more.length;
        (ranked.more ?? []).forEach((s: any) => moreList.appendChild(schoolCard(s, maxScore)));
      } else {
        moreEl.hidden = true;
      }
    }
  }

  function restart() {
    state.step = 0;
    state.answers = {};
    state.typeId = null;
    try {
      localStorage.removeItem(LS_ANSWERS);
      localStorage.removeItem(LS_RESULT);
      localStorage.removeItem(LS_TYPE);
    } catch {
      /* ignore */
    }
    resultCard.hidden = true;
    quizCard.hidden = true;
    renderTypeSelect();
    typeCard.hidden = false;
  }

  prevBtn.addEventListener('click', () => {
    if (state.step > 0) {
      state.step--;
      renderQuestion();
    }
  });

  nextBtn.addEventListener('click', () => {
    const qs = questions();
    const q = qs[state.step];
    if (!q || state.answers[q.id] === undefined) return;
    if (state.step < qs.length - 1) {
      state.step++;
      renderQuestion();
    } else {
      compute();
    }
  });

  restartBtn.addEventListener('click', restart);
  resumeNote?.addEventListener('click', () => {
    if (!window.confirm('确定重新开始吗？已作答的内容会清空。')) return;
    state.step = 0;
    state.answers = {};
    try {
      localStorage.removeItem(LS_ANSWERS);
    } catch {
      /* ignore */
    }
    renderQuestion();
  });
  clearHistoryBtn?.addEventListener('click', () => {
    try {
      localStorage.removeItem(HISTORY_KEY);
    } catch {
      /* ignore */
    }
    renderHistory();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key < '1' || e.key > '9') return;
    const tag = (e.target as HTMLElement)?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (quizCard?.hidden || !resultCard?.hidden) return;
    const opts = Array.from(document.querySelectorAll('#quizOptions .quiz-option'));
    const idx = Number(e.key) - 1;
    if (idx < opts.length) (opts[idx] as HTMLButtonElement).click();
  });

  copyBtn.addEventListener('click', () => {
    const saved = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
    if (!saved) return;
    const { result, advice } = saved;
    const lines = [
      '【象牙塔透视镜·选校测评结果】',
      `兴趣画像：${(result.dims ?? []).map((d: any) => DIM_LABELS[d.dim]).join('、')}`,
      `匹配专业：${(result.majors ?? []).slice(0, 8).join('、')}`,
      `学生视角推荐：${resultSchoolNames(result).slice(0, 3).join('、')}`,
      `家长视角推荐：${resultSchoolNames(result).slice(3, 6).join('、') || resultSchoolNames(result).slice(0, 3).join('、')}`,
      '',
      '选校建议：',
      advice?.text ?? '',
      '',
      '来自：象牙塔透视镜（匹配基于公开资料推断，仅供参考）',
    ].join('\n');
    navigator.clipboard
      ?.writeText(lines)
      .then(() => {
        copyBtn.textContent = '已复制 ✓';
        window.showToast?.('结果已复制到剪贴板');
        setTimeout(() => (copyBtn.textContent = '📋 复制结果'), 1600);
      })
      .catch(() => {});
  });

  copyAdviceBtn?.addEventListener('click', () => {
    const saved = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
    const text = saved?.advice?.text || '';
    if (!text) {
      window.showToast?.('暂无建议内容');
      return;
    }
    navigator.clipboard
      ?.writeText(text)
      .then(() => window.showToast?.('建议已复制'))
      .catch(() => {});
  });

  shareBtn?.addEventListener('click', () => {
    try {
      const payload = { typeId: state.typeId, answers: state.answers };
      const encoded = btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
      const url = `${window.location.origin}/quiz/?r=${encoded}`;
      navigator.clipboard
        ?.writeText(url)
        .then(() => {
          shareBtn.textContent = '已复制 ✓';
          window.showToast?.('分享内容已复制');
          setTimeout(() => (shareBtn.textContent = '🔗 复制结果链接'), 1600);
        })
        .catch(() => {});
    } catch {
      /* ignore */
    }
  });
  printResultBtn?.addEventListener('click', () => window.print());

  regenBtn?.addEventListener('click', async () => {
    const saved = JSON.parse(localStorage.getItem(LS_RESULT) || 'null');
    if (!saved) return;
    regenBtn.disabled = true;
    regenBtn.textContent = '生成中…';
    try {
      const advice = await fetchLLMAdvice(state.answers, saved.result);
      if (advice) {
        const updated = { ...saved, advice, at: Date.now() };
        try {
          localStorage.setItem(LS_RESULT, JSON.stringify(updated));
        } catch {
          /* ignore */
        }
        showResult(updated);
      }
    } catch {
      /* ignore */
    }
    regenBtn.disabled = false;
    regenBtn.textContent = '换一批建议';
  });

  const params = new URLSearchParams(window.location.search);
  const shared = params.get('r');
  let started = false;
  if (shared) {
    try {
      const decoded = JSON.parse(decodeURIComponent(escape(atob(shared))));
      const typeId = decoded?.typeId && QUIZ_TYPES.some((t) => t.id === decoded.typeId) ? decoded.typeId : 'student-full';
      const ans = decoded?.answers ?? decoded;
      if (ans && typeof ans === 'object') {
        state.typeId = typeId;
        Object.assign(state.answers, ans);
        const qs = questionsOf(typeId as any);
        if (qs.every((q) => ans[q.id] !== undefined)) {
          started = true;
          saveAnswers();
          localStorage.setItem(LS_TYPE, typeId);
          compute();
          history.replaceState(null, '', '/quiz/');
        }
      }
    } catch {
      /* ignore */
    }
  }
  if (!started) {
    if (!loadSaved()) {
      renderTypeSelect();
      typeCard.hidden = false;
    } else if (!state.typeId) {
      renderTypeSelect();
      typeCard.hidden = false;
    }
  }
  renderHistory();
</script>
