---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Sticker from '../../components/Sticker.astro';
import { RESOURCE_CATEGORIES } from '../../config';

const universities = (await getCollection('universities')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'zh'),
);

interface ResourceItem {
  category: string;
  categoryLabel: string;
  audience: 'parent' | 'student' | 'both';
  title: string;
  description: string;
  type: string;
  link: string;
  code?: string;
  school: string;
  schoolSlug: string;
}

const all = universities.flatMap<ResourceItem>((u) =>
  u.data.materials.map((m) => ({
    category: m.category,
    categoryLabel:
      RESOURCE_CATEGORIES.find((c) => c.id === m.category)?.label ?? m.category,
    audience: m.audience ?? 'both',
    title: m.title,
    description: m.description,
    type: m.type,
    link: m.link,
    code: m.code,
    school: u.data.name,
    schoolSlug: u.id,
  })),
);

const withMaterials = universities
  .map((u) => ({
    university: u,
    items: all.filter((m) => m.school === u.data.name),
  }))
  .filter((g) => g.items.length > 0);

const byCategory = RESOURCE_CATEGORIES.map((c) => ({
  ...c,
  items: all.filter((m) => m.category === c.id),
}));

const withVideos = universities
  .map((u) => ({
    university: u,
    items: u.data.videos,
  }))
  .filter((g) => g.items.length > 0);

const total = all.length;
const totalVideos = withVideos.reduce((sum, g) => sum + g.items.length, 0);
---

<BaseLayout
  title="资料库"
  description={`按大学归档的资料库，当前共 ${total} 份资料，覆盖培养方案、保研、选课、生活等。`}
>
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <span>资料库</span>
    </nav>
    <div class="page-hero">
      <h1>资料库</h1>
      <p>
        文件资料与视频资料分开归档 📂——文件按大学挂在各自名下、按类别归类，视频同样按大学存放。
        想看哪所大学的"内幕资料"，进来翻就对了！
      </p>
    </div>

    <input
      type="search"
      id="materialSearch"
      class="material-search"
      placeholder="搜索文件资料（标题 / 学校 / 描述）…"
      aria-label="搜索文件资料"
    />

    <div class="tab-bar" role="tablist" aria-label="资料视图切换">
      <button class="tab-btn active" data-view="by-university" role="tab" aria-selected="true" aria-controls="by-university">
        文件 · 按大学
      </button>
      <button class="tab-btn" data-view="by-category" role="tab" aria-selected="false" aria-controls="by-category">
        文件 · 按类别
      </button>
      <button class="tab-btn" data-view="videos" role="tab" aria-selected="false" aria-controls="videos">
        🎬 视频资料
      </button>
    </div>

    <div class="video-filter-bar" role="group" aria-label="按关注视角筛选文件资料">
      <button class="video-filter-btn active" data-aud="all" aria-pressed="true">全部</button>
      <button class="video-filter-btn" data-aud="parent" aria-pressed="false">家长关心</button>
      <button class="video-filter-btn" data-aud="student" aria-pressed="false">学生关心</button>
      <span class="small muted" style="margin-left:auto;">💡 共同关心的资料会在家长/学生视角都出现</span>
    </div>

    <p class="result-count">
      文件资料 {total} 份 · {withMaterials.length} 所学校已收录；视频 {totalVideos} 个
    </p>

    <div id="by-university">
      {withMaterials.map((group, index) => (
        <details class="card video-group" open={index < 3}>
          <summary>
            <a href={`/universities/${group.university.id}/`}>{group.university.data.name}</a>
            <span class="small muted">{group.items.length} 份</span>
          </summary>
          <div
            class="grid"
            style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));"
          >
            {group.items.map((m) => (
              <div class="card material-card" data-audience={m.audience ?? 'both'}>
                <div class="title-row">
                  <h3>{m.title}</h3>
                  <span class="type-chip category-chip">{m.categoryLabel}</span>
                  <span class="type-chip">{m.type}</span>
                </div>
                <p>{m.description}</p>
                {m.code && (
                  <p class="code-line">
                    提取码：<strong>{m.code}</strong>
                    <button class="copy-code-btn" type="button" data-copy-code={m.code}>复制</button>
                  </p>
                )}
                <a
                  class="btn"
                  href={(m.link.startsWith('/') || m.link.startsWith('http')) ? m.link : '#'}
                  target="_blank"
                  rel="noopener"
                >
                  {m.link.startsWith('/') ? '查看文件' : '获取资料'}
                </a>
              </div>
            ))}
          </div>
        </details>
      ))}
      {withMaterials.length < universities.length && (
        <div class="card section-block">
          <p class="muted" style="margin:0;">
            其余学校的学习资料正在陆续整理中。如果你有一手资料，欢迎<a href="/submit/">投稿</a>，
            审核通过后会挂到对应学校名下。
          </p>
        </div>
      )}
    </div>

    <div id="by-category" hidden>
      {byCategory.map((cat) => (
        <section class="section">
          <div class="section-head">
            <h2>{cat.label}</h2>
            <span class="small muted">{cat.items.length} 份</span>
          </div>
          <p class="small muted" style="margin-top:-8px;">{cat.description}</p>
          {cat.items.length > 0 ? (
            <div
              class="grid"
              style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));"
            >
              {cat.items.map((m) => (
                <div class="card material-card" data-audience={m.audience ?? 'both'}>
                  <div class="title-row">
                    <h3>{m.title}</h3>
                    <span class="type-chip school-chip">{m.school}</span>
                    <span class="type-chip">{m.type}</span>
                  </div>
                  <p>{m.description}</p>
                  {m.code && (
                    <p class="code-line">
                      提取码：<strong>{m.code}</strong>
                      <button class="copy-code-btn" type="button" data-copy-code={m.code}>复制</button>
                    </p>
                  )}
                  <a
                    class="btn"
                    href={(m.link.startsWith('/') || m.link.startsWith('http')) ? m.link : '#'}
                    target="_blank"
                    rel="noopener"
                  >
                    {m.link.startsWith('/') ? '查看文件' : '获取资料'}
                  </a>
                </div>
              ))}
            </div>
          ) : (
            <p class="muted">
              该类别暂无资料，欢迎<a href="/submit/">投稿</a>补充。
            </p>
          )}
        </section>
      ))}
    </div>

    <div id="videos" hidden>
      <div class="card quiz-cta">
        <div>
          <h3>看完视频，测一测你适合哪所大学？</h3>
          <p class="muted">2 分钟兴趣问卷 + 选校建议，推荐专业方向与匹配高校。</p>
        </div>
        <a class="btn btn-primary" href="/quiz/">开始测评 →</a>
      </div>
      <div class="video-filter-bar" role="group" aria-label="按视频类型筛选">
        <button class="video-filter-btn active" data-vtag="all" aria-pressed="true">全部</button>
        <button class="video-filter-btn" data-vtag="宣传片" aria-pressed="false">宣传片</button>
        <button class="video-filter-btn" data-vtag="宿舍生活" aria-pressed="false">宿舍生活</button>
        <button class="video-filter-btn" data-vtag="学习日常" aria-pressed="false">学习日常</button>
      </div>
      <p class="small muted video-summary">
        共 {withVideos.length} 所高校 · {totalVideos} 条视频，点击学校名可展开/收起。
      </p>
      <input
        type="search"
        id="videoSearch"
        class="video-search"
        placeholder="搜索学校，如：东北大学、清华、武汉…"
        aria-label="搜索学校视频"
      />
      <div class="video-tools">
        <button class="btn btn-ghost" id="expandAll" type="button">展开全部</button>
        <button class="btn btn-ghost" id="collapseAll" type="button">收起全部</button>
      </div>
      {withVideos.map((group, index) => (
        <details class="card video-group" open={index < 5}>
          <summary>
            <a href={`/universities/${group.university.id}/`}>{group.university.data.name}</a>
            <span class="small muted">{group.items.length} 个视频</span>
          </summary>
          <div class="grid grid-videos">
            {group.items.map((video) => <VideoEmbed video={video} />)}
          </div>
        </details>
      ))}
      {withVideos.length === 0 && (
        <div class="empty-state">
          <Sticker emoji="🎬" animate="wiggle" label="暂无视频" />
          <p class="muted">视频还在路上，欢迎投稿～</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  type AppWindow = Window & {
    __appReady?: (fn: () => void) => void;
  };
  const appWin = window as AppWindow;

  function initResources() {
    const searchEl = document.getElementById('materialSearch');
    if (!searchEl || searchEl.dataset.appInit === '1') return;
    searchEl.dataset.appInit = '1';

  document.querySelectorAll('[data-copy-code]').forEach((b) => {
    b.addEventListener('click', () => {
      navigator.clipboard
        ?.writeText(b.dataset.copyCode ?? '')
        .then(() => window.showToast?.('提取码已复制'))
        .catch(() => {});
    });
  });

  const buttons = Array.from(document.querySelectorAll('.tab-btn'));
  const views = {
    'by-university': document.getElementById('by-university'),
    'by-category': document.getElementById('by-category'),
    videos: document.getElementById('videos'),
  };
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      for (const [name, el] of Object.entries(views)) {
        if (el) el.hidden = name !== btn.dataset.view;
      }
    });
  });
  const tabbar = document.querySelector('.tab-bar');
  tabbar?.addEventListener('keydown', (e) => {
    const idx = buttons.indexOf(document.activeElement);
    if (idx === -1) return;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault();
      buttons[(idx + 1) % buttons.length].focus();
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault();
      buttons[(idx - 1 + buttons.length) % buttons.length].focus();
    } else if (e.key === 'Home') {
      e.preventDefault();
      buttons[0].focus();
    } else if (e.key === 'End') {
      e.preventDefault();
      buttons[buttons.length - 1].focus();
    }
  });
  buttons.forEach((b) => b.addEventListener('focus', () => b.click()));

  const filterBtns = Array.from(document.querySelectorAll('.video-filter-btn'));
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      const tag = btn.dataset.vtag ?? 'all';
      document.querySelectorAll('.video-card').forEach((card) => {
        const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
        card.style.display = tag === 'all' || tags.includes(tag) ? '' : 'none';
      });
    });
  });

  const tagCounts = { 宣传片: 0, 宿舍生活: 0, 学习日常: 0 };
  document.querySelectorAll('.video-card').forEach((card) => {
    (card.dataset.tags ?? '').split(' ').forEach((t) => {
      if (t in tagCounts) tagCounts[t]++;
    });
  });
  const allCount = Object.values(tagCounts).reduce((n, c) => n + c, 0);
  filterBtns.forEach((btn) => {
    const t = btn.dataset.vtag;
    if (t === 'all') btn.textContent = `全部 ${allCount}`;
    else if (t in tagCounts) btn.textContent = `${t} ${tagCounts[t]}`;
  });

  const videoSearch = document.getElementById('videoSearch');
  const videoGroups = Array.from(document.querySelectorAll('.video-group'));
  const videoSummary = document.querySelector('.video-summary');
  const OPEN_KEY = 'open-video-groups';
  let openSet = new Set();
  try {
    openSet = new Set(JSON.parse(localStorage.getItem(OPEN_KEY) || '[]'));
  } catch {
    openSet = new Set();
  }
  videoGroups.forEach((g, i) => {
    const name = g.querySelector('summary a')?.textContent?.trim() ?? `g${i}`;
    if (openSet.size > 0) {
      g.open = openSet.has(name);
    } else if (i < 5) {
      g.open = true;
    }
    g.addEventListener('toggle', () => {
      if (g.open) openSet.add(name);
      else openSet.delete(name);
      try {
        localStorage.setItem(OPEN_KEY, JSON.stringify([...openSet]));
      } catch {
        /* ignore */
      }
    });
  });
  const expandAllBtn = document.getElementById('expandAll');
  const collapseAllBtn = document.getElementById('collapseAll');
  expandAllBtn?.addEventListener('click', () => {
    openSet = new Set(videoGroups.map((g) => g.querySelector('summary a')?.textContent?.trim() ?? ''));
    videoGroups.forEach((g) => {
      g.open = true;
    });
    try {
      localStorage.setItem(OPEN_KEY, JSON.stringify([...openSet]));
    } catch {
      /* ignore */
    }
  });
  collapseAllBtn?.addEventListener('click', () => {
    openSet = new Set();
    videoGroups.forEach((g) => {
      g.open = false;
    });
    try {
      localStorage.setItem(OPEN_KEY, '[]');
    } catch {
      /* ignore */
    }
  });
  videoSearch?.addEventListener('input', () => {
    const kw = videoSearch.value.trim().toLowerCase();
    let visible = 0;
    videoGroups.forEach((g) => {
      const name = (g.querySelector('summary a')?.textContent ?? '').toLowerCase();
      const show = !kw || name.includes(kw);
      g.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (videoSummary) {
      videoSummary.textContent = `匹配 ${visible} 所高校，点击学校名可展开/收起。`;
    }
  });

  const searchInput = document.getElementById('materialSearch');
  const resultCount = document.querySelector('.result-count');
  const defaultCountText = resultCount?.textContent ?? '';
  let currentAud = 'all';
  const audBtns = Array.from(document.querySelectorAll('[data-aud]'));
  audBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      audBtns.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      currentAud = btn.dataset.aud ?? 'all';
      applyMaterialFilter();
    });
  });
  function applyMaterialFilter() {
    const kw = searchInput.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll('.material-card').forEach((card) => {
      const aud = card.dataset.audience ?? 'both';
      const audOk = currentAud === 'all' || aud === currentAud || aud === 'both';
      const text = (card.textContent ?? '').toLowerCase();
      const show = audOk && (!kw || text.includes(kw));
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (resultCount) {
      resultCount.textContent =
        kw || currentAud !== 'all' ? `匹配 ${visible} 份资料` : defaultCountText;
    }
  }
  searchInput?.addEventListener('input', applyMaterialFilter);
  }

  appWin.__appReady?.(initResources);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initResources);
  } else {
    initResources();
  }
</script>
