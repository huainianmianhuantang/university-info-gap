---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { RESOURCE_CATEGORIES } from '../../config';

const universities = (await getCollection('universities')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'zh'),
);

interface ResourceItem {
  category: string;
  categoryLabel: string;
  title: string;
  description: string;
  type: string;
  link: string;
  code?: string;
  school: string;
  schoolSlug: string;
}

const all = universities.flatMap<ResourceItem>((u) =>
  u.data.materials.map((m) => ({
    category: m.category,
    categoryLabel:
      RESOURCE_CATEGORIES.find((c) => c.id === m.category)?.label ?? m.category,
    title: m.title,
    description: m.description,
    type: m.type,
    link: m.link,
    code: m.code,
    school: u.data.name,
    schoolSlug: u.id,
  })),
);

const withMaterials = universities
  .map((u) => ({
    university: u,
    items: all.filter((m) => m.school === u.data.name),
  }))
  .filter((g) => g.items.length > 0);

const byCategory = RESOURCE_CATEGORIES.map((c) => ({
  ...c,
  items: all.filter((m) => m.category === c.id),
})).filter((c) => c.items.length > 0);

const withVideos = universities
  .map((u) => ({
    university: u,
    items: u.data.videos,
  }))
  .filter((g) => g.items.length > 0);

const total = all.length;
const totalVideos = withVideos.reduce((sum, g) => sum + g.items.length, 0);
---

<BaseLayout
  title="资料库"
  description={`按大学归档的资料库，当前共 ${total} 份资料，覆盖培养方案、保研、选课、生活等。`}
>
  <div class="container page">
    <div class="page-hero">
      <h1>资料库</h1>
      <p>
        文件资料与视频资料分开归档。文件按大学挂在各自名下、按类别归类；视频同样按大学存放。
        其他学校后续直接往对应类别中添加即可。
      </p>
    </div>

    <div class="tab-bar" role="tablist">
      <button class="tab-btn active" data-view="by-university" role="tab" aria-selected="true">
        文件 · 按大学
      </button>
      <button class="tab-btn" data-view="by-category" role="tab" aria-selected="false">
        文件 · 按类别
      </button>
      <button class="tab-btn" data-view="videos" role="tab" aria-selected="false">
        视频资料
      </button>
    </div>

    <p class="result-count">
      文件资料 {total} 份 · {withMaterials.length} 所学校已收录；视频 {totalVideos} 个
    </p>

    <div id="by-university">
      {withMaterials.map((group) => (
        <section class="section">
          <div class="section-head">
            <h2>
              <a href={`/universities/${group.university.id}/`}>{group.university.data.name}</a>
            </h2>
            <span class="small muted">{group.items.length} 份</span>
          </div>
          <div
            class="grid"
            style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));"
          >
            {group.items.map((m) => (
              <div class="card material-card">
                <div class="title-row">
                  <h3>{m.title}</h3>
                  <span class="type-chip category-chip">{m.categoryLabel}</span>
                  <span class="type-chip">{m.type}</span>
                </div>
                <p>{m.description}</p>
                {m.code && <p>提取码：<strong>{m.code}</strong></p>}
                <a class="btn" href={m.link} target="_blank" rel="noopener">
                  {m.link.startsWith('/') ? '查看文件' : '获取资料'}
                </a>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div id="by-category" hidden>
      {byCategory.map((cat) => (
        <section class="section">
          <div class="section-head">
            <h2>{cat.label}</h2>
            <span class="small muted">{cat.items.length} 份</span>
          </div>
          <p class="small muted" style="margin-top:-8px;">{cat.description}</p>
          <div
            class="grid"
            style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));"
          >
            {cat.items.map((m) => (
              <div class="card material-card">
                <div class="title-row">
                  <h3>{m.title}</h3>
                  <span class="type-chip school-chip">{m.school}</span>
                  <span class="type-chip">{m.type}</span>
                </div>
                <p>{m.description}</p>
                {m.code && <p>提取码：<strong>{m.code}</strong></p>}
                <a class="btn" href={m.link} target="_blank" rel="noopener">
                  {m.link.startsWith('/') ? '查看文件' : '获取资料'}
                </a>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div id="videos" hidden>
      {withVideos.map((group) => (
        <section class="section">
          <div class="section-head">
            <h2>
              <a href={`/universities/${group.university.id}/`}>{group.university.data.name}</a>
            </h2>
            <span class="small muted">{group.items.length} 个视频</span>
          </div>
          <div class="grid grid-videos">
            {group.items.map((video) => <VideoEmbed video={video} />)}
          </div>
        </section>
      ))}
      {withVideos.length === 0 && (
        <p class="muted">暂无视频资料，欢迎投稿。</p>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll('.tab-btn'));
  const views = {
    'by-university': document.getElementById('by-university'),
    'by-category': document.getElementById('by-category'),
    videos: document.getElementById('videos'),
  };
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      for (const [name, el] of Object.entries(views)) {
        if (el) el.hidden = name !== btn.dataset.view;
      }
    });
  });
</script>
