---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversityCard from '../components/UniversityCard.astro';
import HomeGuide from '../components/HomeGuide.astro';
import { SITE } from '../config';
import { formatDate } from '../utils';

const universities = (await getCollection('universities')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'zh'),
);
const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime(),
);
const featured = universities.filter((u) => u.data.featured);
const showcase = (featured.length ? featured : universities).slice(0, 3);
const totalVideos = universities.reduce((n, u) => n + u.data.videos.length, 0);
const totalMaterials = universities.reduce((n, u) => n + u.data.materials.length, 0);
const topicTags = [...new Set(articles.flatMap((a) => a.data.tags))].slice(0, 12);
const schoolBriefs = universities.map((u) => ({ id: u.id, name: u.data.name }));

const categories = [
  { icon: '⇄', label: '转专业政策', desc: '申请条件、考核方式、名额限制', href: '/universities/' },
  { icon: '★', label: '二次选拔', desc: '实验班、基地班、拔尖计划', href: '/universities/' },
  { icon: '床', label: '寝室与上课', desc: '几人间、独卫空调、课程体验', href: '/universities/' },
  { icon: '▤', label: '资料库', desc: '培养方案、保研、选课等一手资料', href: '/resources/' },
  { icon: '🎯', label: '选校测评', desc: '兴趣问卷 + AI 建议，推荐专业与高校', href: '/quiz/' },
];
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.url}/universities/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  })}></script>
  <div class="container page">
        <div class="page-bg" aria-hidden="true">
          <div class="page-edge-grad"></div>
          <div class="bg-breath bg-breath-1"></div>
          <div class="bg-breath bg-breath-2"></div>
          <div class="bg-ring bg-ring-1"></div>
          <div class="bg-ring bg-ring-2"></div>
          <div class="bg-ring bg-ring-3"></div>
          <div class="bg-dot" style="left:5%; top:18%; width:5px; height:5px; animation-delay:0s; animation-duration:6s;"></div>
          <div class="bg-dot" style="right:8%; top:12%; width:4px; height:4px; animation-delay:0.7s; animation-duration:7s;"></div>
          <div class="bg-dot" style="left:12%; top:42%; width:3px; height:3px; animation-delay:1.4s; animation-duration:5.5s;"></div>
          <div class="bg-dot" style="right:4%; top:38%; width:6px; height:6px; animation-delay:2.1s; animation-duration:8s;"></div>
          <div class="bg-dot" style="left:7%; top:64%; width:4px; height:4px; animation-delay:2.8s; animation-duration:6.5s;"></div>
          <div class="bg-dot" style="right:10%; top:62%; width:3px; height:3px; animation-delay:3.4s; animation-duration:7.5s;"></div>
          <div class="bg-dot" style="left:15%; top:86%; width:5px; height:5px; animation-delay:0.4s; animation-duration:6s;"></div>
          <div class="bg-dot" style="right:5%; top:88%; width:4px; height:4px; animation-delay:1.1s; animation-duration:5.5s;"></div>
          <div class="bg-dot" style="left:3%; top:30%; width:3px; height:3px; animation-delay:2s; animation-duration:7s;"></div>
          <div class="bg-dot" style="right:12%; top:24%; width:5px; height:5px; animation-delay:2.6s; animation-duration:6.5s;"></div>
          <div class="bg-dot" style="left:10%; top:54%; width:4px; height:4px; animation-delay:3s; animation-duration:8s;"></div>
          <div class="bg-dot" style="right:7%; top:76%; width:3px; height:3px; animation-delay:0.9s; animation-duration:6s;"></div>
        </div>
        <div class="welcome-banner card" id="welcomeBanner" hidden>
      <span class="welcome-emoji" id="welcomeEmoji">👋</span>
      <div class="welcome-text">
        <b id="welcomeTitle"></b>
        <span id="welcomeSub">收藏、测评结果和 AI 对话都保存在你的账号下。</span>
      </div>
      <a class="btn btn-ghost btn-xs" href="/account/">个人中心</a>
    </div>
<section class="hero">
      <div class="hero-bg" aria-hidden="true">
        <svg class="hero-tower" viewBox="0 0 340 360" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g stroke="#fff">
            <path d="M24 340 V196 h66 v144" stroke-width="2" opacity="0.5"/>
            <path d="M42 340 V248 h26" stroke-width="1.2" opacity="0.38"/>
            <rect x="48" y="262" width="12" height="18" rx="6" stroke-width="1.2" opacity="0.5"/>
            <rect x="52" y="302" width="10" height="14" rx="5" stroke-width="1" opacity="0.35"/>
            <path d="M250 340 V180 h66 v160" stroke-width="2" opacity="0.5"/>
            <path d="M270 340 V236 h24" stroke-width="1.2" opacity="0.38"/>
            <rect x="274" y="244" width="12" height="18" rx="6" stroke-width="1.2" opacity="0.5"/>
            <rect x="278" y="284" width="10" height="14" rx="5" stroke-width="1" opacity="0.35"/>
            <path d="M112 340 V104 h116 v236" stroke-width="2.2" opacity="0.65"/>
            <path d="M170 24 L130 104 h80 Z" stroke-width="2" opacity="0.6"/>
            <path d="M170 24 L170 104" stroke-width="1" opacity="0.35" stroke-dasharray="3 5"/>
            <path d="M144 132 h52 v58 h-52 Z M170 132 v58" stroke-width="1.2" opacity="0.5"/>
            <path d="M144 206 h52 v58 h-52 Z M170 206 v58" stroke-width="1.2" opacity="0.42"/>
            <path d="M144 278 h52 v46 h-52 Z M170 278 v46" stroke-width="1" opacity="0.35"/>
            <circle cx="170" cy="176" r="12" stroke-width="1.4" opacity="0.55"/>
            <path d="M170 176 v-7 M170 176 h5" stroke-width="1.2" opacity="0.55"/>
            <path d="M112 140 h116 M112 214 h116 M112 288 h116" stroke-width="1" opacity="0.3" stroke-dasharray="5 7"/>
            <path d="M130 104 h80 M112 340 h116" stroke-width="1" opacity="0.25" stroke-dasharray="5 7"/>
            <path d="M8 340 h324" stroke-width="2" opacity="0.5"/>
            <path d="M20 354 h300" stroke-width="1.2" opacity="0.25"/>
          </g>
        </svg>
        <div class="lens-ring lens-ring-1"></div>
        <div class="lens-ring lens-ring-2"></div>
        <div class="lens-ring lens-ring-3"></div>
        <div class="scan-beam"></div>
        <div class="hero-particle" style="left:74%; bottom:34%; width:5px; height:5px;"></div>
        <div class="hero-particle" style="left:86%; bottom:22%; width:4px; height:4px; animation-delay:1.2s;"></div>
        <div class="hero-particle" style="left:80%; bottom:56%; width:3px; height:3px; animation-delay:2.4s;"></div>
        <div class="hero-particle" style="left:92%; bottom:44%; width:6px; height:6px; animation-delay:0.8s;"></div>
        <div class="hero-particle" style="left:70%; bottom:68%; width:4px; height:4px; animation-delay:1.8s;"></div>
        <div class="hero-particle" style="left:88%; bottom:72%; width:3px; height:3px; animation-delay:3s;"></div>
        <div class="hero-particle" style="left:77%; bottom:12%; width:5px; height:5px; animation-delay:2s;"></div>
      </div>
      <h1>选大学，先看清“象牙塔”</h1>
      <p>
        {SITE.description}
      </p>
      <form class="hero-search" action="/search/" method="get">
        <input
          type="search"
          name="q"
          placeholder="全站搜索：大学 / 转专业 / 宿舍 / 保研…"
          aria-label="全站搜索"
        />
        <button type="submit">搜索</button>
      </form>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/quiz/">🎯 2 分钟测一测适合什么专业与学校</a>
      </div>
      <div class="hero-stats" data-reveal>
        <span>收录 <b class="stat-num" data-count={universities.length}>0</b> 所 985 高校</span>
        <span><b class="stat-num" data-count={totalVideos}>0</b> 条校园/政策视频</span>
        <span><b class="stat-num" data-count={totalMaterials}>0</b> 份学习资料</span>
        <span>专题文章 <b class="stat-num" data-count={articles.length}>0</b> 篇</span>
      </div>
      <div data-reveal data-reveal-delay="1">
        <span class="hero-badge">🔄 内容持续更新中</span>
      </div>
      <div data-reveal data-reveal-delay="2">
        <a class="hero-scroll" href="#guide" aria-label="向下查看新手介绍">↓</a>
      </div>
    </section>

    <HomeGuide />

    <section class="section">
      <div class="section-head">
        <h2>重点大学</h2>
        <div class="section-links">
          <a class="more" href="/articles/985-city-map/">985 是什么？→</a>
          <a class="more" href="/universities/">查看全部 →</a>
        </div>
      </div>
      <div class="grid grid-universities" data-reveal>
        {showcase.map((u) => <UniversityCard university={u} />)}
      </div>
    </section>

    <section class="section" id="recentSection" hidden>
      <div class="section-head">
        <h2>最近浏览</h2>
        <button class="btn btn-ghost" id="clearRecent" type="button">清除</button>
      </div>
      <div class="chip-row" id="recentList" data-reveal></div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>你想了解什么？</h2>
      </div>
      <div class="grid grid-categories">
        {categories.map((c, i) => (
          <a class="card category-card" href={c.href} data-reveal data-reveal-delay={i}>
            <div class="category-icon">{c.icon}</div>
            <h3>{c.label}</h3>
            <p>{c.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>最新文章</h2>
        <a class="more" href="/articles/">更多 →</a>
      </div>
      <div class="grid grid-articles">
        {articles.slice(0, 3).map((article, i) => (
          <a class="card article-card" href={`/articles/${article.id}/`} data-reveal data-reveal-delay={i}>
            <h3>{article.data.title}</h3>
            <p>{article.data.summary}</p>
            <span class="date">{formatDate(article.data.date)} · {article.data.tags.join(' / ')}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" data-reveal>
      <div class="section-head">
        <h2>热门话题</h2>
      </div>
      <div class="chip-row">
        {topicTags.map((t) => (
          <a class="chip" href={`/search/?q=${encodeURIComponent(t)}`}>{t}</a>
        ))}
      </div>
    </section>

    <section class="section" id="faq" data-reveal style="scroll-margin-top:84px;">
      <div class="section-head">
        <h2>常见问题</h2>
      </div>
      <details class="card faq-item">
        <summary>这里的信息靠谱吗？</summary>
        <p>政策类信息以各高校官方发布为准，并标注了来源；学生视角的宿舍、课堂内容来自在校生实拍/投稿，仅供参考。</p>
      </details>
      <details class="card faq-item">
        <summary>视频是从哪里来的？</summary>
        <p>主要来自高校官方 B 站账号与在校生实拍，每条都标注了来源（官方账号或转载 UP 主），并分为宣传片 / 宿舍生活 / 学习日常三类。</p>
      </details>
                  <details class="card faq-item">
        <summary>需要登录才能用吗？账号数据存在哪？</summary>
        <p>不需要，所有功能都可以匿名使用。登录（手机号/密码，QQ/微信演示绑定）后，收藏、测评结果和 AI 对话会按账号保存；当前数据只存在你自己的浏览器里，云同步正在规划中。</p>
      </details>
<details class="card faq-item">
        <summary>右下角的 AI 小助手能干什么？</summary>
        <p>可以问它怎么用这个网站、怎么选专业方向、转专业要注意什么；它会结合站内栏目给出建议，并提醒你以官方信息为准。</p>
      </details>
<details class="card faq-item">
        <summary>选校测评的结果能直接用来填志愿吗？</summary>
        <p>不能。测评只回答“适合什么方向”，不包含分数与位次；请结合高考成绩、一分一段表与官方招生章程综合决策。</p>
      </details>
      <details class="card faq-item">
        <summary>学习资料为什么放在网盘？</summary>
        <p>文件资料体量较大，为保持网站轻快，采用夸克网盘存放，条目里附有链接和提取码（如 DKVL）。</p>
      </details>
      <details class="card faq-item">
        <summary>我想补充信息或纠错，怎么操作？</summary>
        <p>每个学校详情页都有「纠错 / 补充此页」按钮，也可直接到<a href="/submit/">投稿页</a>提交，我们会审核后发布并注明来源。</p>
      </details>
    </section>

    <section class="section card section-block">
      <h2>这个网站是做什么的？</h2>
      <p class="prose">
        高考选校最大的痛点，是网上的信息要么太官方、要么太零散。我们把每所大学的
        <strong>转专业政策、二次选拔、培养计划、寝室实况、上课体验、学习资料和视频</strong>
        整理到同一张页面里，方便对比。
      </p>
      <p class="prose">
        内容由在校生与家长共同投稿、人工审核后发布。如果你有一手信息，欢迎
        <a href="/submit/">投稿</a>；若发现错误，也请告诉我们，我们会尽快修正。
      </p>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ schoolBriefs }}>
  window.__SCHOOL_BRIEFS__ = schoolBriefs;
</script>

<script>
  import { getProfile } from '../lib/account';
  const schoolBriefs = (window as unknown as { __SCHOOL_BRIEFS__?: typeof window.__SCHOOL_BRIEFS__ }).__SCHOOL_BRIEFS__ ?? [];
  const welcomeBanner = document.getElementById('welcomeBanner');
  const profileNow = getProfile();
  if (welcomeBanner && profileNow) {
    document.getElementById('welcomeTitle').textContent = '欢迎回来，' + profileNow.nickname + '！';
    document.getElementById('welcomeEmoji').textContent = '👋';
    welcomeBanner.hidden = false;
  }

  const recentSection = document.getElementById('recentSection');
  const recentList = document.getElementById('recentList');
  const clearRecent = document.getElementById('clearRecent');
  try {
    const recent = JSON.parse(localStorage.getItem('recent-universities') || '[]');
    const items = recent
      .map((id) => schoolBriefs.find((s) => s.id === id))
      .filter(Boolean);
    if (items.length > 0 && recentSection && recentList) {
      recentSection.hidden = false;
      items.forEach((s) => {
        const a = document.createElement('a');
        a.className = 'chip';
        a.href = `/universities/${s.id}/`;
        a.textContent = s.name;
        recentList.appendChild(a);
      });
    }
  } catch {
    /* ignore */
  }
  clearRecent?.addEventListener('click', () => {
    try {
      localStorage.removeItem('recent-universities');
    } catch {
      /* ignore */
    }
    if (recentSection) recentSection.hidden = true;
  });

  const statNums = document.querySelectorAll('.stat-num');
  const animateCount = (el: Element) => {
    const target = Number((el as HTMLElement).dataset.count || 0);
    const dur = 900;
    const t0 = performance.now();
    const step = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            animateCount(e.target);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 },
    );
    statNums.forEach((n) => io.observe(n));
  } else {
    statNums.forEach((n) => {
      n.textContent = String((n as HTMLElement).dataset.count ?? '0');
    });
  }
</script>
