---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversityCard from '../components/UniversityCard.astro';
import HomeGuide from '../components/HomeGuide.astro';
import { SITE } from '../config';
import { formatDate } from '../utils';

const universities = (await getCollection('universities')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'zh'),
);
const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime(),
);
const featured = universities.filter((u) => u.data.featured);
const showcase = (featured.length ? featured : universities).slice(0, 3);
const totalVideos = universities.reduce((n, u) => n + u.data.videos.length, 0);
const totalMaterials = universities.reduce((n, u) => n + u.data.materials.length, 0);
const topicTags = [...new Set(articles.flatMap((a) => a.data.tags))].slice(0, 12);
const schoolBriefs = universities.map((u) => ({ id: u.id, name: u.data.name }));

const categories = [
  { icon: '⇄', label: '转专业政策', desc: '申请条件、考核方式、名额限制', href: '/universities/' },
  { icon: '★', label: '二次选拔', desc: '实验班、基地班、拔尖计划', href: '/universities/' },
  { icon: '床', label: '寝室与上课', desc: '几人间、独卫空调、课程体验', href: '/universities/' },
  { icon: '▤', label: '资料库', desc: '培养方案、保研、选课等一手资料', href: '/resources/' },
  { icon: '🎯', label: '选校测评', desc: '兴趣问卷 + AI 建议，推荐专业与高校', href: '/quiz/' },
];
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.url}/universities/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  })}></script>
  <div class="container page">
    <section class="hero">
      <h1>选大学，先看清“象牙塔”</h1>
      <p>
        {SITE.description}
      </p>
      <form class="hero-search" action="/search/" method="get">
        <input
          type="search"
          name="q"
          placeholder="全站搜索：大学 / 转专业 / 宿舍 / 保研…"
          aria-label="全站搜索"
        />
        <button type="submit">搜索</button>
      </form>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/quiz/">🎯 2 分钟测一测适合什么专业与学校</a>
      </div>
      <div class="hero-stats">
        <span>收录 {universities.length} 所 985 高校</span>
        <span>{totalVideos} 条校园/政策视频</span>
        <span>{totalMaterials} 份学习资料</span>
        <span>专题文章 {articles.length} 篇</span>
      </div>
    </section>

    <HomeGuide />

    <section class="section">
      <div class="section-head">
        <h2>重点大学</h2>
        <a class="more" href="/universities/">查看全部 →</a>
      </div>
      <div class="grid grid-universities">
        {showcase.map((u) => <UniversityCard university={u} />)}
      </div>
    </section>

    <section class="section" id="recentSection" hidden>
      <div class="section-head">
        <h2>最近浏览</h2>
        <button class="btn btn-ghost" id="clearRecent" type="button">清除</button>
      </div>
      <div class="chip-row" id="recentList"></div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>你想了解什么？</h2>
      </div>
      <div class="grid grid-categories">
        {categories.map((c) => (
          <a class="card category-card" href={c.href}>
            <div class="category-icon">{c.icon}</div>
            <h3>{c.label}</h3>
            <p>{c.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>最新文章</h2>
        <a class="more" href="/articles/">更多 →</a>
      </div>
      <div class="grid grid-articles">
        {articles.slice(0, 3).map((article) => (
          <a class="card article-card" href={`/articles/${article.id}/`}>
            <h3>{article.data.title}</h3>
            <p>{article.data.summary}</p>
            <span class="date">{formatDate(article.data.date)} · {article.data.tags.join(' / ')}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>热门话题</h2>
      </div>
      <div class="chip-row">
        {topicTags.map((t) => (
          <a class="chip" href={`/search/?q=${encodeURIComponent(t)}`}>{t}</a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>常见问题</h2>
      </div>
      <details class="card faq-item">
        <summary>这里的信息靠谱吗？</summary>
        <p>政策类信息以各高校官方发布为准，并标注了来源；学生视角的宿舍、课堂内容来自在校生实拍/投稿，仅供参考。</p>
      </details>
      <details class="card faq-item">
        <summary>视频是从哪里来的？</summary>
        <p>主要来自高校官方 B 站账号与在校生实拍，每条都标注了来源（官方账号或转载 UP 主），并分为宣传片 / 宿舍生活 / 学习日常三类。</p>
      </details>
            <details class="card faq-item">
        <summary>右下角的 AI 小助手能干什么？</summary>
        <p>可以问它怎么用这个网站、怎么选专业方向、转专业要注意什么；它会结合站内栏目给出建议，并提醒你以官方信息为准。</p>
      </details>
<details class="card faq-item">
        <summary>选校测评的结果能直接用来填志愿吗？</summary>
        <p>不能。测评只回答“适合什么方向”，不包含分数与位次；请结合高考成绩、一分一段表与官方招生章程综合决策。</p>
      </details>
      <details class="card faq-item">
        <summary>学习资料为什么放在网盘？</summary>
        <p>文件资料体量较大，为保持网站轻快，采用夸克网盘存放，条目里附有链接和提取码（如 DKVL）。</p>
      </details>
      <details class="card faq-item">
        <summary>我想补充信息或纠错，怎么操作？</summary>
        <p>每个学校详情页都有「纠错 / 补充此页」按钮，也可直接到<a href="/submit/">投稿页</a>提交，我们会审核后发布并注明来源。</p>
      </details>
    </section>

    <section class="section card section-block">
      <h2>这个网站是做什么的？</h2>
      <p class="prose">
        高考选校最大的痛点，是网上的信息要么太官方、要么太零散。我们把每所大学的
        <strong>转专业政策、二次选拔、培养计划、寝室实况、上课体验、学习资料和视频</strong>
        整理到同一张页面里，方便对比。
      </p>
      <p class="prose">
        内容由在校生与家长共同投稿、人工审核后发布。如果你有一手信息，欢迎
        <a href="/submit/">投稿</a>；若发现错误，也请告诉我们，我们会尽快修正。
      </p>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ schoolBriefs }}>
  const recentSection = document.getElementById('recentSection');
  const recentList = document.getElementById('recentList');
  const clearRecent = document.getElementById('clearRecent');
  try {
    const recent = JSON.parse(localStorage.getItem('recent-universities') || '[]');
    const items = recent
      .map((id) => schoolBriefs.find((s) => s.id === id))
      .filter(Boolean);
    if (items.length > 0 && recentSection && recentList) {
      recentSection.hidden = false;
      items.forEach((s) => {
        const a = document.createElement('a');
        a.className = 'chip';
        a.href = `/universities/${s.id}/`;
        a.textContent = s.name;
        recentList.appendChild(a);
      });
    }
  } catch {
    /* ignore */
  }
  clearRecent?.addEventListener('click', () => {
    try {
      localStorage.removeItem('recent-universities');
    } catch {
      /* ignore */
    }
    if (recentSection) recentSection.hidden = true;
  });
</script>
