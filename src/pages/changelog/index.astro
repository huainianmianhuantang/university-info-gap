---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const universities = await getCollection('universities');
const articles = await getCollection('articles');
const stats = {
  schools: universities.length,
  videos: universities.reduce((n, u) => n + u.data.videos.length, 0),
  materials: universities.reduce((n, u) => n + u.data.materials.length, 0),
  articles: articles.length,
};

const updates = [
  {
    date: '2026-08-22',
    title: '界面细节打磨',
    items: [
      '大学库：无结果时展示友好空状态卡片，一键清除全部筛选；筛选区移动端纵向排布',
      '资料库：标签页支持键盘 ←→ 切换，视频筛选按钮补齐无障碍状态',
      '测评页：进度显示百分比，位次输入在手机上一行排布',
      '首页与全局：FAQ 展开箭头动画、分类图标悬停微动、胶囊/搜索按钮悬停反馈、文字选区主题色',
      '搜索页：无结果提示升级为卡片 + 一键清空关键词',
      '修复：帮助菜单与页脚「重新测评」误导文案改为「重新引导」',
    ],
  },
  {
    date: '2026-08-22',
    title: '信息渠道整合',
    items: [
      '每所高校详情页新增「关注与信息渠道」：官网 / B 站 / 小红书 / 抖音 / 微博 分类入口',
      '滚动渐显动效 + 页面动画转场，浏览体验升级',
      '全站持续安全与体验优化',
    ],
  },

  {
    date: '2026-08-21 晚',
    title: '账号体系与体验大更新',
    items: [
      '新增登录系统：手机号+验证码（开发演示）/密码登录，QQ/微信绑定入口',
      '个人中心：昵称/绑定管理、设置密码、导出数据、删除账号',
      '登录后体验：投稿自动带身份、AI 助手问候、收藏/测评/对话按账号隔离',
      '界面 AI 小助手上线，支持贴边最小化',
      '首次访问引导问卷 + 首页交互新手介绍',
      '全局 Toast、阅读进度条、标签筛选、提取码一键复制等体验优化',
      '安全加固：CSP 响应头、PBKDF2 密码哈希、登录失败锁定、XSS 修复',
    ],
  },

  {
    date: '2026-08-21',
    title: '批量优化',
    items: [
      '校徽图片压缩至 512px，页面加载明显变快',
      '新增面包屑导航与站内全站搜索',
      '测评结果支持分享链接与冲/稳/保分档',
      '深色模式、收藏夹对比/导出、视频学校搜索',
      '详情页可一键纠错/补充、加入对比',
    ],
  },
  {
    date: '2026-08-20',
    title: '核心功能上线',
    items: [
      '39 所 985 高校详情页与官方校徽',
      '116 条校园/政策视频，按宣传片/宿舍生活/学习日常分类',
      '选校测评 + DeepSeek AI 建议',
      '大学对比页（2-3 所并排、差异高亮）',
      '东北大学完整样板页（培养方案/寝室/上课/29 份资料）',
    ],
  },
  {
    date: '2026-08-19',
    title: '站点框架',
    items: ['资料库按大学/类别归档', '夸克网盘资料迁移', '专题文章与投稿体系'],
  },
];
---

<BaseLayout title="更新日志" description="象牙塔透视镜网站的功能更新记录。">
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <span>更新日志</span>
    </nav>
    <div class="page-hero">
      <h1>更新日志</h1>
      <p>记录网站每次重要的功能与内容更新，方便你了解我们一直在做什么。</p>
    </div>

    <section class="card section-block">
      <h2>站点数据</h2>
      <div class="hero-stats">
        <span>收录 {stats.schools} 所 985 高校</span>
        <span>{stats.videos} 条视频</span>
        <span>{stats.materials} 份资料</span>
        <span>{stats.articles} 篇文章</span>
      </div>
    </section>

    {updates.map((u) => (
      <section class="card section-block">
        <div class="section-head">
          <h2>{u.title}</h2>
          <span class="date">{u.date}</span>
        </div>
        <ul class="point-list">
          {u.items.map((item) => (
            <li class="point-item">
              <p>{item}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
