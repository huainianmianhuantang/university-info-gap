---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sticker from '../components/Sticker.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已移动。">
  <div class="container page">
    <div class="page-hero">
      <Sticker emoji="🌪️" animate="spin" size={72} label="页面被风吹走" />
      <h1>404 · 页面走丢了</h1>
      <p>哎呀，这页被风吹走了～回<a href="/">首页</a>，或去<a href="/universities/">大学库</a>逛逛吧！</p>
      <form class="hero-search" action="/search/" method="get">
        <input
          type="search"
          name="q"
          placeholder="全站搜索：大学 / 文章 / 资料…"
          aria-label="全站搜索"
        />
        <button type="submit">🔍 搜索</button>
      </form>
      <p>
        <a class="btn btn-primary" href="/">返回首页</a>
        <a class="btn btn-ghost" href="/quiz/">试试选校测评</a>
      </p>
    </div>
  </div>
</BaseLayout>
