---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已移动。">
  <div class="container page">
    <div class="page-hero">
      <h1>404 · 页面走丢了</h1>
      <p>你访问的页面不存在或已移动。可以回<a href="/">首页</a>，或去<a href="/universities/">大学库</a>逛逛。</p>
      <p>
        <a class="btn btn-primary" href="/">返回首页</a>
        <a class="btn btn-ghost" href="/quiz/">试试选校测评</a>
      </p>
    </div>
  </div>
</BaseLayout>
