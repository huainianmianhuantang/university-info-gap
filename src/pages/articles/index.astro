---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime(),
);
const allTags = [...new Set(articles.flatMap((a) => a.data.tags))];
---

<BaseLayout title="专题文章" description="转专业攻略、培养计划解读等选校干货。">
  <div class="container page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a> › <span>专题文章</span>
    </nav>
    <div class="page-hero">
      <h1>📚 专题文章</h1>
      <p>政策解读、选校思路与过来人经验，帮你少走弯路、多看门道。</p>
    </div>
    <div class="chip-row" id="tagFilter">
      <button class="chip tag-chip on" data-tag="全部" type="button" aria-pressed="true">全部</button>
      {allTags.map((t) => <button class="chip tag-chip" data-tag={t} type="button" aria-pressed="false">{t}</button>)}
    </div>
    <div class="grid grid-articles">
      {articles.map((article, i) => (
        <a class="card article-card" data-tags={article.data.tags.join(',')} href={`/articles/${article.id}/`} data-reveal data-reveal-delay={i % 4}>
          <h3>{article.data.title}</h3>
          <p>{article.data.summary}</p>
          <span class="date">{formatDate(article.data.date)} · {article.data.tags.join(' / ')}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  type AppWindow = Window & {
    __appReady?: (fn: () => void) => void;
  };
  const appWin = window as AppWindow;

  function initArticles() {
    const pageRoot = document.getElementById('tagFilter');
    if (!pageRoot || pageRoot.dataset.appInit === '1') return;
    pageRoot.dataset.appInit = '1';

  const filter = document.getElementById('tagFilter');
  const cards = Array.from(document.querySelectorAll('.article-card'));
  function applyTag(tag) {
    filter.querySelectorAll('.tag-chip').forEach((b) => {
      const active = (b.dataset.tag ?? '') === tag;
      b.classList.toggle('on', active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    cards.forEach((card) => {
      const tags = (card as HTMLElement).dataset.tags ?? '';
      card.hidden = tag !== '全部' && !tags.includes(tag);
    });
  }

  const initTag = decodeURIComponent(window.location.hash.replace(/^#tag-/, ''));
  if (initTag) applyTag(initTag);

  filter?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.tag-chip');
    if (!btn) return;
    const tag = (btn as HTMLElement).dataset.tag ?? '全部';
    applyTag(tag);
    history.replaceState(null, '', tag === '全部' ? location.pathname : '#tag-' + encodeURIComponent(tag));
  });
  }

  appWin.__appReady?.(initArticles);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticles);
  } else {
    initArticles();
  }
</script>
