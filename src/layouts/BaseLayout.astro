---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OnboardingModal from '../components/OnboardingModal.astro';
import HelpButton from '../components/HelpButton.astro';
import AiAssistant from '../components/AiAssistant.astro';
import AccountModal from '../components/AccountModal.astro';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const pageDescription = description ?? SITE.description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (function () {
        // 全局 page-ready 注册表：每个脚本把幂等 init 注册进来，
        // 在页面加载和每次客户端跳转（astro:page-load）后统一执行，
        // 解决视图过渡下共享/页面脚本不重跑导致监听器丢失的问题。
        window.__appInits = window.__appInits || [];
        window.__appReady = function (fn) {
          if (typeof fn === 'function') window.__appInits.push(fn);
        };
        window.__appBind = function (el, key, type, fn) {
          if (!el || el.dataset[key]) return;
          el.dataset[key] = '1';
          el.addEventListener(type, fn);
        };
        function runAppInits() {
          var list = window.__appInits || [];
          for (var i = 0; i < list.length; i++) {
            try {
              list[i]();
            } catch (e) {
              /* 单个 init 出错不阻塞其他 */
            }
          }
        }
        if (!window.__appReadyBound) {
          window.__appReadyBound = true;
          document.addEventListener('DOMContentLoaded', runAppInits);
          document.addEventListener('astro:page-load', runAppInits);
        }

        function applyTheme() {
          try {
            var t = localStorage.getItem('theme');
            if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            var root = document.documentElement;
            root.classList.add('theme-switching');
            root.setAttribute('data-theme', t);
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                root.classList.remove('theme-switching');
              });
            });
            var btn = document.getElementById('themeToggle');
            if (btn) {
              btn.textContent = t === 'dark' ? '☀️' : '🌙';
              btn.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
            }
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', t === 'dark' ? '#0d1526' : '#1f5eff');
          } catch (e) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        }
        applyTheme();
        // 视图过渡（客户端导航）会清掉 <html> 上的 data-theme，这里在每次切换后恢复
        if (!window.__themeRestoreBound) {
          window.__themeRestoreBound = true;
          document.addEventListener('astro:page-load', applyTheme);
        }
        // 未手动选择主题时，实时跟随系统深浅色（避免重复绑定）
        if (!window.__themeSystemBound) {
          window.__themeSystemBound = true;
          var sysMq = window.matchMedia('(prefers-color-scheme: dark)');
          var onSysChange = function () {
            try {
              if (!localStorage.getItem('theme')) applyTheme();
            } catch (e) {
              /* ignore */
            }
          };
          if (typeof sysMq.addEventListener === 'function') {
            sysMq.addEventListener('change', onSysChange);
          } else if (typeof sysMq.addListener === 'function') {
            sysMq.addListener(onSysChange);
          }
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#1f5eff" />
    <ClientRouter />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <meta name="format-detection" content="telephone=no" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://player.bilibili.com" crossorigin />
    <link rel="dns-prefetch" href="https://player.bilibili.com" />
    <link rel="canonical" href={`${SITE.url.replace(/\/$/, '')}${Astro.url.pathname}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={`${SITE.url.replace(/\/$/, '')}${Astro.url.pathname}`} />
    <meta property="og:image" content={`${SITE.url.replace(/\/$/, '')}/images/og-default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${SITE.url.replace(/\/$/, '')}/images/og-default.png`} />
  </head>
  <body>
    <noscript>
      <p style="text-align:center;padding:12px;background:#fff3cd;color:#7a5b00;">
        本站部分功能（测评、搜索、视频）需要启用 JavaScript 才能正常使用。
      </p>
    </noscript>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <button class="back-to-top" id="backToTop" aria-label="回到顶部" hidden>↑</button>
    <div class="install-banner" id="installBanner" hidden>
      <span>📱 把「{SITE.title}」装到桌面，随时查大学</span>
      <button class="btn btn-primary" id="installBtn" type="button">安装</button>
      <button class="install-close" id="installClose" type="button" aria-label="关闭">×</button>
    </div>
    <OnboardingModal />
    <HelpButton />
    <AiAssistant />
    <AccountModal />
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </body>
</html>

<script>
  type AppWindow = Window & {
    __appReady?: (fn: () => void) => void;
    __appBind?: (el: Element | null, key: string, type: string, fn: EventListener) => void;
    showToast?: (msg: string) => void;
  };
  const appWin = window as AppWindow;
  const bind = (el: Element | null, key: string, type: string, fn: EventListener) =>
    appWin.__appBind?.(el, key, type, fn);

  let deferredPrompt: any = null;

  function initShell() {
    document.documentElement.classList.add('js');

    // 回到顶部
    const btn = document.getElementById('backToTop');
    const onScroll = () => {
      if (btn) btn.hidden = window.scrollY < 400;
    };
    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    bind(btn, 'appBackTop', 'click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    // 滚动渐显
    const revealEls = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('reveal-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -30px 0px' },
      );
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('reveal-in'));
    }

    // 安装横幅按钮（窗口事件一次性注册）
    bind(document.getElementById('installBtn'), 'appInstall', 'click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      try {
        await deferredPrompt.userChoice;
      } catch {
        /* ignore */
      }
      deferredPrompt = null;
      const banner = document.getElementById('installBanner');
      if (banner) banner.hidden = true;
    });
    bind(document.getElementById('installClose'), 'appInstallClose', 'click', () => {
      const banner = document.getElementById('installBanner');
      if (banner) banner.hidden = true;
    });
  }

  // toast 只注册一次，调用时按 id 查找当前 DOM
  if (!appWin.showToast) {
    appWin.showToast = (msg: string) => {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.hidden = false;
      clearTimeout((toast as HTMLElement & { _t?: number })._t);
      (toast as HTMLElement & { _t?: number })._t = window.setTimeout(() => {
        toast.hidden = true;
      }, 2000);
    };
  }

  // 一次性窗口级监听：SW 注册、PWA 安装提示
  if (!window.__installBound) {
    window.__installBound = true;
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      const banner = document.getElementById('installBanner');
      if (banner) banner.hidden = false;
    });
    window.addEventListener('appinstalled', () => {
      const banner = document.getElementById('installBanner');
      if (banner) banner.hidden = true;
    });
  }

  appWin.__appReady?.(initShell);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShell);
  } else {
    initShell();
  }
</script>
